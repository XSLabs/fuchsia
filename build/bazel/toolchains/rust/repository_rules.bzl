"""Repository rules used to populate Rust-based repositories."""

load(
    "@rules_fuchsia//fuchsia/workspace:utils.bzl",
    "abspath_from_full_label_or_repo_relpath",
)

_FUCHSIA_TARGET_TRIPLE_TO_CPU = {
    "aarch64-unknown-fuchsia": "arm64",
    "riscv64gc-unknown-fuchsia": "riscv64",
    "x86_64-unknown-fuchsia": "x64",
}

def _extract_libstd_constants(repo_ctx):
    """Extract per-CPU libstd shared library paths from the prebuilt runtime.json.

    The prebuilt Rust toolchain ships a runtime.json describing, for each target
    triple and set of rustflags, the runtime artifacts that a binary built with
    those flags needs at execution time. We care about the entries built with
    -Cprefer-dynamic, which is what the Fuchsia Rust toolchains use.

    The libstd shared library name embeds a hash that changes on every toolchain
    roll, so it must never be hardcoded in a BUILD file.

    Args:
        repo_ctx: the repository context.

    Returns:
        A dict mapping Fuchsia CPU name to the libstd shared library path,
        relative to the root of this repository.
    """
    entries = json.decode(repo_ctx.read("lib/runtime.json"))

    result = {}
    for entry in entries:
        if entry["rustflags"] != ["-Cprefer-dynamic"]:
            continue
        for triple in entry["target"]:
            cpu = _FUCHSIA_TARGET_TRIPLE_TO_CPU.get(triple)
            if not cpu:
                continue
            for runtime in entry["runtime"]:
                if runtime["name"] != "libstd":
                    continue
                dist = "lib/" + runtime["dist"]

                # fx_packaged_binary installs this file under its base name,
                # but the loader looks it up by the soname that rustc recorded
                # in the binary. The two are equal today; fail here rather than
                # at component start if that ever stops being true.
                if runtime["soname"] != dist.split("/")[-1]:
                    fail("libstd soname %s does not match dist path %s" % (
                        runtime["soname"],
                        dist,
                    ))

                previous = result.get(cpu)
                if previous and previous != dist:
                    fail("Conflicting -Cprefer-dynamic libstd entries for %s in runtime.json: %s vs %s" % (
                        cpu,
                        previous,
                        dist,
                    ))
                result[cpu] = dist

    missing = [
        cpu
        for cpu in _FUCHSIA_TARGET_TRIPLE_TO_CPU.values()
        if cpu not in result
    ]
    if missing:
        fail("No -Cprefer-dynamic libstd entry in runtime.json for: %s" % missing)

    return result

def _format_constants(libstd_dist):
    lines = [
        "# AUTO-GENERATED by //build/bazel/toolchains/rust/repository_rules.bzl",
        "# DO NOT EDIT",
        "",
        "constants = struct(",
        "    libstd_dist = {",
    ]
    for cpu in sorted(libstd_dist):
        lines.append('        "%s": "%s",' % (cpu, libstd_dist[cpu]))
    lines += [
        "    },",
        ")",
        "",
    ]
    return "\n".join(lines)

def _generate_prebuilt_rust_toolchain_repository_impl(repo_ctx):
    if repo_ctx.attr.repository_version_file:
        # Force Bazel to record an association with this file. If its content
        # changes (for example after a `jiri update` that rolls the prebuilt
        # Rust toolchain), this repository is re-generated. This matters
        # because generated_constants.bzl below embeds the libstd file name,
        # which contains a hash that changes on every roll.
        repo_ctx.watch("%s/%s" % (
            str(repo_ctx.workspace_root),
            repo_ctx.attr.repository_version_file,
        ))

    # Symlink the content of the Rust installation directory into the repository.
    # This allows us to add Bazel-specific files in this location.
    repo_ctx.execute(
        [
            repo_ctx.path(Label("@//build/bazel/scripts:symlink-directory.py")),
            abspath_from_full_label_or_repo_relpath(
                repo_ctx,
                repo_ctx.attr.rust_install_dir,
            ),
            ".",
        ],
        quiet = False,  # False for debugging!
    )

    # Symlink the BUILD.bazel file.
    repo_ctx.symlink(
        repo_ctx.workspace_root.get_child("build/bazel/toolchains/rust/rust.BUILD.bazel"),
        "BUILD.bazel",
    )

    repo_ctx.file(
        "generated_constants.bzl",
        _format_constants(_extract_libstd_constants(repo_ctx)),
        executable = False,
    )

generate_prebuilt_rust_toolchain_repository = repository_rule(
    implementation = _generate_prebuilt_rust_toolchain_repository_impl,
    attrs = {
        "rust_install_dir": attr.string(
            mandatory = True,
            doc = "Location of prebuilt Rust toolchain installation, a full label, or relative to workspace dir",
        ),
        "repository_version_file": attr.string(
            mandatory = False,
            doc = "Rust toolchain content identification file, relative to workspace root.",
        ),
    },
)
