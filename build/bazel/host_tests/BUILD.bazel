# Load the list of Bazel host test targets collected from the
# bazel_host_test_suite() dependencies of //:bazel_host_test_suites
# in the GN graph.
load("@fuchsia_build_info//:bazel_host_test_suites.bzl", test_suites_in_gn_graph = "bazel_host_test_suites")

package(default_applicable_licenses = ["//:license"])

# The list of host tests that will be built in __ALL__ builder
# configurations. These tests should be small and critical
# to the build.
#
# To add other tests, consider adding them as dependencies to
# a `test_suite()` target defined in a BUILD.bazel file.
test_suite(
    name = "default_host_tests",
    tests = [
        "//build/bazel/rules/build_flags/tests:host_tests",
        "//build/bazel/rules/host_tests/tests:host_tests",
        "//build/tools/json_validator/test:tests",
        "//tools/check-licenses:tests",
    ],
    visibility = ["//:__subpackages__"],
)

test_suite(
    name = "host_tests",
    tests = test_suites_in_gn_graph + [
        #  ________  _________  ________  ________
        # |\   ____\|\___   ___\\   __  \|\   __  \
        # \ \  \___|\|___ \  \_\ \  \|\  \ \  \|\  \
        #  \ \_____  \   \ \  \ \ \  \\\  \ \   ____\
        #   \|____|\  \   \ \  \ \ \  \\\  \ \  \___|
        #     ____\_\  \   \ \__\ \ \_______\ \__\
        #    |\_________\   \|__|  \|_______|\|__|
        #    \|_________|
        #
        # DO NOT ADD to this list directly, see //build/bazel/host_tests/README.md
        # on how to export Bazel host tests.
        ":default_host_tests",
    ],
)
