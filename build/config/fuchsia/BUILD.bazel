load("@fuchsia_build_info//:args.bzl", "zircon_asserts")
load("@fuchsia_rules_common//build_flags:build_flags.bzl", "build_flags")

package(default_applicable_licenses = ["//:license"])

# LINT.IfChange(zircon_asserts)
build_flags(
    name = "enable_zircon_asserts",
    defines = ["ZX_ASSERT_LEVEL=2"],
    visibility = ["//visibility:public"],
)

build_flags(
    name = "zircon_asserts",
    subflags = [":enable_zircon_asserts"] if zircon_asserts else [],
    visibility = ["//visibility:public"],
)
# LINT.ThenChange(//build/config/fuchsia/BUILD.gn:zircon_asserts)
