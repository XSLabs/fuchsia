import("//build/python/python_library.gni")

group("tests") {
  testonly = true
  deps = [
    ":tests-no-e2e",
    "e2e:tests",
  ]
}

group("tests-no-e2e") {
  testonly = true
  deps = [ "//build/bazel/bazel_sdk:tests" ]
}

if (is_host) {
  # Python scripts in this directory that aren't part of any other Python
  # target, usually because they're run directly by action() or Bazel rules.
  # Listing them here makes them subject to type checking.
  python_library("type_checked_scripts") {
    testonly = true

    # This target only exists for type checking; depending on it would package
    # a grab-bag of unrelated scripts.
    visibility = [
      ":*",
      "//build:*",
    ]
    sources = [
      "bazel_rules_fuchsia/common/scripts/zip-directory.py",
      "bazel_rules_fuchsia/fuchsia/tools/check_restricted_symbols.py",
      "bazel_rules_fuchsia/fuchsia/tools/construct_budgets_file.py",
      "bazel_rules_fuchsia/fuchsia/tools/create_package_manifest_list.py",
      "bazel_rules_fuchsia/fuchsia/tools/create_platform_aibs_file.py",
      "bazel_rules_fuchsia/fuchsia/tools/development_status.py",
      "bazel_rules_fuchsia/fuchsia/tools/elf_sizes.py",
      "bazel_rules_fuchsia/fuchsia/tools/ensure_build_config.py",
      "bazel_rules_fuchsia/fuchsia/tools/fuchsia_shell_task.py",
      "bazel_rules_fuchsia/fuchsia/tools/fuchsia_task_lib.py",
      "bazel_rules_fuchsia/fuchsia/tools/json_comparator.py",
      "bazel_rules_fuchsia/fuchsia/tools/licenses/classification_types.py",
      "bazel_rules_fuchsia/fuchsia/tools/licenses/generate_licenses_classification.py",
