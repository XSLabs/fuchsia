import("//build/python/python_library.gni")

group("tests") {
  testonly = true
  deps = [
    ":tests-no-e2e",
    "e2e:tests",
  ]
}

group("tests-no-e2e") {
  testonly = true
  deps = [ "//build/bazel/bazel_sdk:tests" ]
}

if (is_host) {
  # Python scripts in this directory that aren't part of any other Python
  # target, usually because they're run directly by action() or Bazel rules.
  # Listing them here makes them subject to type checking.
  python_library("type_checked_scripts") {
    testonly = true

    # This target only exists for type checking; depending on it would package
    # a grab-bag of unrelated scripts.
    visibility = [
      ":*",
      "//build:*",
    ]
    sources = [
      "tests/scripts/bazel_test.py",
      "tests/tools/package_checker.py",
    ]
  }
}
