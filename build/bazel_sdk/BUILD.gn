      "bazel_rules_fuchsia/fuchsia/tools/licenses/generate_licenses_spdx.py",
      "bazel_rules_fuchsia/fuchsia/tools/licenses/remove_license_segment.py",
      "bazel_rules_fuchsia/fuchsia/tools/licenses/verify_licenses_collection.py",
      "bazel_rules_fuchsia/fuchsia/tools/publish_packages.py",
      "bazel_rules_fuchsia/fuchsia/tools/register_debug_symbols.py",
      "bazel_rules_fuchsia/fuchsia/tools/register_driver.py",
      "bazel_rules_fuchsia/fuchsia/tools/run_component.py",
      "bazel_rules_fuchsia/fuchsia/tools/run_ffx.py",
