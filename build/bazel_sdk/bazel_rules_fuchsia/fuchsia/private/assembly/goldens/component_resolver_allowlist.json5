[
    // List of all components that can have in their environment registered for scheme "fuchsia-pkg"
    // the "full_resolver" capability provided by "/bootstrap/pkg-cache".
    {
        scheme: "fuchsia-pkg",
        moniker: "/bootstrap/pkg-cache",
        resolver: "full_resolver",
        components: [],
    },

    // List of all components that can have in their environment registered for scheme "fuchsia-pkg"
    // the "full-resolver" capability provided by "/core/pkg-resolver".
    {
        scheme: "fuchsia-pkg",
        moniker: "/core/pkg-resolver",
        resolver: "full-resolver",
        components: [],
    },
]
