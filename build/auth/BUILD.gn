import("//build/python/python_library.gni")
import("//build/testing/python_build_time_tests.gni")

if (is_host) {
  group("tests") {
    testonly = true
    deps = [
      ":apt_test($host_toolchain)",
      ":gcloud_creds_test($host_toolchain)",
      ":gcloud_test($host_toolchain)",
      ":select_auth_method_test($host_toolchain)",
    ]
  }

  python_library("apt") {
    sources = [ "apt.py" ]
  }

  python_library("gcloud") {
    sources = [ "gcloud.py" ]
    library_deps = [ ":apt" ]
  }

  python_library("gcloud_creds") {
    sources = [ "gcloud_creds.py" ]
    library_deps = [
      ":apt",
      ":gcloud",
    ]
  }

  python_library("select_auth_method") {
    sources = [ "select_auth_method.py" ]
    library_deps = [ ":gcloud" ]
  }

  python_build_time_tests("apt_test") {
    tests = [ "apt_test.py" ]
    inputs = [ "apt.py" ]
    deps = [ ":apt" ]
  }

  python_build_time_tests("gcloud_test") {
    tests = [ "gcloud_test.py" ]
    inputs = [ "gcloud.py" ]
    deps = [ ":gcloud" ]
  }

  python_build_time_tests("gcloud_creds_test") {
    tests = [ "gcloud_creds_test.py" ]
    inputs = [ "gcloud_creds.py" ]
    deps = [
      ":apt",
      ":gcloud",
      ":gcloud_creds",
    ]
  }

  python_build_time_tests("select_auth_method_test") {
    tests = [ "select_auth_method_test.py" ]
    inputs = [
      "select_auth_method.py",
      "gcloud.py",
    ]
    deps = [ ":select_auth_method" ]
  }
} else {
  # If evaluated on the target toolchain (e.g. via fx add-test), redirect the
  # target's evaluation cleanly and safely to the host toolchain.
  group("tests") {
    testonly = true
    deps = [ ":tests($host_toolchain)" ]
  }
}
