import("//build/python/python_binary.gni")
import("//build/testing/python_build_time_tests.gni")

python_binary("zip_helper") {
  main_source = "zip_helper.py"
}

if (is_host) {
  python_build_time_tests("distribution_manifest_unittests") {
    tests = [ "distribution_manifest_unittests.py" ]
    deps = [ "//build/python/modules/distribution_manifest" ]
  }
}

group("tests") {
  testonly = true
  deps = [ ":distribution_manifest_unittests($host_toolchain)" ]
}
