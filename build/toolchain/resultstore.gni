declare_args() {
  # DEPRECATED: Configure ninja to stream build events and results to a service.
  # This option is now deprecated and ignored. Use '--resultstore' or 'fx
  # resultstore' instead.
  ninja_upload_build_events = ""
}

assert(
    ninja_upload_build_events == "",
    "The GN variable 'ninja_upload_build_events' has been deprecated. Please use the command-line flag '--resultstore' on 'fx build' or configure a persistent default using 'fx resultstore enable [--local]'.")
