if (is_host) {
  config("example_flags") {
    defines = [ "EXAMPLE_MACRO=1" ]
    include_dirs = [ "src" ]
  }

  static_library("c_example_lib") {
    sources = [
      "src/c_lib.c",
      "src/c_lib.h",
    ]
    public_configs = [ ":example_flags" ]
  }

  static_library("cc_example_lib") {
    sources = [
      "src/cc_lib.cc",
      "src/cc_lib.h",
    ]
    public_configs = [ ":example_flags" ]
  }

  static_library("asm_example_lib") {
    sources = [ "src/asm_func.S" ]
    public_configs = [ ":example_flags" ]
  }

  executable("cc_example_bin") {
    sources = [ "src/main.cc" ]
    deps = [
      ":asm_example_lib",
      ":c_example_lib",
      ":cc_example_lib",
    ]
    configs += [ ":example_flags" ]
  }
}
