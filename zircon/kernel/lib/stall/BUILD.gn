import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

library_headers("headers") {
  headers = [ "lib/stall.h" ]
}

kernel_rust_mod("stall_rs") {
  output_name = "stall"
  source_root = "src/mod.rs"
  sources = [ "src/mod.rs" ]
  deps = [
    "//sdk/rust/zx-types",
    "//src/lib/ksync",
    "//third_party/rust_crates:pin-init",
  ]
  test_deps = [ "//zircon/kernel/lib/unittest:unittest-rs" ]
}

source_set("stall") {
  public_deps = [ ":headers" ]

  sources = [ "stall.cc" ]
  deps = [
    ":stall_rs",
    "//zircon/kernel/lib/init",
  ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
  deps = [ "tests" ]
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
