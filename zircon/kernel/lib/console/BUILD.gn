import("//build/cpp/library_headers.gni")
import("//build/testing/boot_tests/boot_test.gni")
import("//zircon/kernel/kernel_rust_crate.gni")

static_library("console") {
  public_deps = [ ":headers" ]

  complete_static_lib = true

  sources = [ "console.cc" ]
  defines = [ "BOOT_TEST_SUCCESS_STRING=\"$boot_test_success_string\"" ]
  deps = [
    "//zircon/kernel/lib/boot-options:headers",
    "//zircon/kernel/lib/debuglog:headers",
    "//zircon/kernel/lib/init",
  ]
}

library_headers("headers") {
  headers = [ "lib/console.h" ]
  public_deps = [
    # <lib/console.h> has #include <lib/special-sections/special-sections.h>.
    "//zircon/kernel/lib/special-sections:headers",
  ]
}

kernel_rust_crate("console_rust") {
  crate_name = "console_rust"
  visibility = [
    "//zircon/kernel/bin:*",
    "//zircon/kernel/lib/console/*",
    "//zircon/kernel/top:*",
  ]
  sources = [ "rust/src/lib.rs" ]
  source_root = "rust/src/lib.rs"
  deps = [
    "//sdk/rust/zx-status",
    "//src/lib/kalloc",
    "//src/lib/zr",
    "//zircon/kernel/lib/debuglog:debuglog-rs",
    "//zircon/kernel/platform:platform-rs",
  ]
  rustenv = [ "BOOT_TEST_SUCCESS_STRING=$boot_test_success_string" ]
}

group("tests") {
  testonly = true
}

group("kernel-tests") {
  testonly = true
  deps = [ "tests" ]
}

group("phys-tests") {
  testonly = true
}

group("boot_tests") {
  testonly = true
}
