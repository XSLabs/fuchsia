import("//zircon/kernel/kernel_rust_crate.gni")

kernel_rust_crate("console_tests_rust") {
  testonly = true
  sources = [ "src/lib.rs" ]
  deps = [
    "//sdk/rust/zx-status",
    "//src/lib/zr",
    "//zircon/kernel/lib/console:console_rust",
    "//zircon/kernel/lib/unittest:unittest-rs",
    "//zircon/kernel/platform:platform-rs",
  ]
}

source_set("tests") {
  testonly = true
  sources = [ "console_tests.cc" ]
  deps = [
    ":console_tests_rust",
    "//zircon/kernel/lib/console",
    "//zircon/kernel/lib/unittest",
  ]
}
