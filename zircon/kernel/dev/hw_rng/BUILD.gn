import("//build/cpp/library_headers.gni")
import("//zircon/kernel/kernel_rust_mod.gni")

kernel_rust_mod("hw_rng-rs") {
  visibility = [ ":*" ]
  sources = [ "hw_rng.rs" ]
  deps = [ "//src/lib/zr" ]
}

source_set("hw_rng") {
  public_deps = [ ":headers" ]

  sources = [
    "debug.cc",
    "hw_rng_ffi.cc",
  ]
  deps = [
    ":hw_rng-rs",
    "//zircon/kernel/lib/console",
    "//zircon/system/ulib/pretty",
  ]
}

library_headers("headers") {
  headers = [ "dev/hw_rng.h" ]
}
