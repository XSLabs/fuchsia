import("//zircon/kernel/kernel_rust_mod.gni")

kernel_rust_mod("plic-rs") {
  output_name = "plic"
  source_root = "plic.rs"
  sources = [ "plic.rs" ]
  deps = [
    "//sdk/rust/zbi",
    "//src/lib/lazy_init:lazy_init_rs",
    "//src/lib/regio",
    "//zircon/kernel/lib/debug",
    "//zircon/kernel/lib/page:page-rs",
  ]
}

source_set("plic") {
  sources = []
  deps = [
    ":plic-rs",
    "//zircon/kernel/dev/pdev/interrupt",
    "//zircon/kernel/lib/root_resource_filter",
  ]
}
