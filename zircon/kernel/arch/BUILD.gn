import("//build/rust/rustc_library.gni")

rustc_library("arch-rs") {
  edition = "2024"
  sources = [ "src/lib.rs" ]
  deps = [ "//sdk/rust/zx-status" ]
  if (current_cpu == "arm64") {
    deps += [ "//zircon/kernel/arch/arm64:arch-arm64-rs" ]
  } else if (current_cpu == "riscv64") {
    deps += [ "//zircon/kernel/arch/riscv64:arch-riscv64-rs" ]
  } else if (current_cpu == "x64") {
    deps += [ "//zircon/kernel/arch/x86:arch-x86-rs" ]
  }
  non_rust_deps = [ ":ffi" ]
}

source_set("ffi") {
  sources = [ "arch_ffi.cc" ]
  deps = [ "//zircon/kernel/lib/ktl" ]
}
