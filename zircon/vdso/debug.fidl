library zx;

@transport("Syscall")
closed protocol Debug {
    /// ## Summary
    ///
    /// Read a message from the debug serial port.
    ///
    /// ## Declaration
    ///
    /// ```c
    /// #include <zircon/syscalls.h>
    ///
    /// zx_status_t zx_debug_read(zx_handle_t handle,
    ///                           char* buffer,
    ///                           size_t buffer_size,
    ///                           size_t* actual);
    /// ```
    ///
    /// ## Description
    ///
    /// `zx_debug_read()` attempts to read data from the debug serial port.
    /// The parameter *buffer_size* is used to specify the byte size of the read buffer.
    /// The length of *buffer*, in bytes, is stored in the location pointed to by
    /// *actual*.
    ///
    /// This function will wait until at least one byte is available before it returns.
    /// This can return up to *buffer_size* bytes.
    ///
    /// `NOTE:` There is only one buffer of the data that is coming from the debug
    /// serial, and calling `zx_debug_read` consumes this data. If multiple programs are calling
    /// this at once, they will each receive pieces of the data stream.
    ///
    /// To use the `zx_debug_read()` function, you must specify
    /// `kernel.enable-serial-syscalls=true` on the kernel command line. Otherwise,
    /// the function returns `ZX_ERR_NOT_SUPPORTED`.
    ///
    /// ## Rights
    ///
    /// *handle* must have resource kind `ZX_RSRC_KIND_SYSTEM` with base
    /// `ZX_RSRC_SYSTEM_DEBUG_BASE`.
    ///
    /// ## Return value
    ///
    /// Returns `ZX_OK` on success. The location pointed to by *buffer* contains
    /// *actual* bytes that were read.
    ///
    /// ## Errors
    ///
    /// `ZX_ERR_NOT_SUPPORTED`  `kernel.enable-serial-syscalls` is not set to `true`
    /// on the kernel command line.
    ///
    /// `ZX_ERR_INVALID_ARGS`  *buffer* or *actual* are NULL.
    ///
    /// ## See also
    ///
    ///  - [kernel command line]
    ///  - [`zx_debug_resume()`]
    ///  - [`zx_debug_suspend()`]
    ///  - [`zx_debug_write()`]
    ///  - [`zx_debuglog_read()`]
    ///  - [`zx_debuglog_write()`]
    ///
    /// [kernel command line]: /docs/reference/kernel/kernel_cmdline.md
    /// [`zx_debug_resume()`]: debug_resume.md
    /// [`zx_debug_suspend()`]: debug_suspend.md
    /// [`zx_debug_write()`]: debug_write.md
    /// [`zx_debuglog_read()`]: debuglog_read.md
    /// [`zx_debuglog_write()`]: debuglog_write.md
    @blocking
    strict Read(resource struct {
        handle Handle:RESOURCE;
    }) -> (struct {
        buffer vector<uchar>:MAX;
        actual usize64;
    }) error Status;

    /// ## Summary
    ///
    /// Write a message to the debug serial port.
    ///
    /// ## Declaration
    ///
    /// ```c
    /// #include <zircon/syscalls.h>
    ///
    /// zx_status_t zx_debug_write(const char* buffer, size_t buffer_size);
    /// ```
    ///
    /// ## Description
    ///
    /// `zx_debug_write()` attempts to write data of *buffer_size* bytes to the debug serial port.
    ///
    /// To use the `zx_debug_write()` function, you must specify
    /// `kernel.enable-serial-syscalls=true` or
    /// `kernel.enable-serial-syscalls=output-only` on the kernel command line.
    /// Otherwise, the function returns `ZX_ERR_NOT_SUPPORTED`.
    ///
    /// `zx_debug_write` is intended for diagnostic use.  Data may be dropped or
    /// truncated, but the data from two different `zx_debug_write` calls will not be
    /// interleaved or reordered.
    ///
    /// If access to the debug serial port has been suspended (see
    /// [`zx_debug_suspend()`]), `zx_debug_write()` blocks until it has been
    /// resumed.  A thread blocked in `zx_debug_write()` may be suspended or
    /// killed.
    ///
    /// ## Rights
    ///
    /// None.
    ///
    /// ## Return value
    ///
    /// Returns `ZX_OK` on success.
    ///
    /// ## Errors
    ///
    /// `ZX_ERR_NOT_SUPPORTED`  `kernel.enable-serial-syscalls` is not set to `true`
    /// or `output-only` on the kernel command line.
    ///
    /// `ZX_ERR_INVALID_ARGS` *buffer* is NULL.
    ///
    /// ## See also
    ///
    ///  - [kernel command line]
    ///  - [`zx_debug_read()`]
    ///  - [`zx_debug_resume()`]
    ///  - [`zx_debug_suspend()`]
    ///  - [`zx_debuglog_read()`]
    ///  - [`zx_debuglog_write()`]
    ///
    /// [kernel command line]: /docs/reference/kernel/kernel_cmdline.md
    /// [`zx_debug_read()`]: debug_read.md
    /// [`zx_debug_resume()`]: debug_resume.md
    /// [`zx_debug_suspend()`]: debug_suspend.md
    /// [`zx_debuglog_read()`]: debuglog_read.md
    /// [`zx_debuglog_write()`]: debuglog_write.md
    @blocking
    strict Write(struct {
        buffer vector<uchar>:MAX;
    }) -> () error Status;

    /// ## Summary
    ///
    /// Suspend access to the debug serial port hardware.
    ///
    /// ## Declaration
    ///
    /// ```c
    /// #include <zircon/syscalls-next.h>
    ///
    /// zx_status_t zx_debug_suspend(zx_handle_t resource);
    /// ```
    ///
    /// ## Description
    ///
    /// `zx_debug_suspend()` prevents access to the debug serial port (UART)
    /// hardware until a subsequent call to [`zx_debug_resume()`] is made.  Once
    /// `zx_debug_suspend()` returns successfully, it is safe for the caller to
    /// remove power and/or clocks from the debug serial port hardware if
    /// desired.
    ///
    /// Before returning, `zx_debug_suspend()` waits for any in-progress
    /// accesses of the debug serial port to complete and for any output queued
    /// in the hardware to be transmitted, and performs any driver specific
    /// preparation required before the hardware may be powered down.  If the
    /// hardware is unable to make progress (e.g. transmission is stalled by
    /// flow control), this may block indefinitely.  A thread blocked in
    /// `zx_debug_suspend()` may be suspended or killed.
    ///
    /// While the debug serial port is suspended:
    ///
    ///  - Log messages continue to be recorded in the kernel debuglog.
    ///    They will be emitted to the debug serial port after it has been
    ///    resumed, subject to the capacity of the debuglog.
    ///  - Calls to [`zx_debug_write()`] block until the port is resumed.  Threads
    ///    blocked in [`zx_debug_write()`] may be suspended or killed.
    ///  - Calls to [`zx_debug_read()`] return any data which was received prior
    ///    to suspension, and otherwise block until data is available.
    ///  - If the system panics, no output is written to the debug serial port.
    ///    Instead, the system will reboot (even if `kernel.halt-on-panic=true`)
    ///    and the crashlog will note that the debug serial port was suspended at
    ///    the time of the panic.
    ///
    /// Unlike [`zx_debug_read()`] and [`zx_debug_write()`],
    /// `zx_debug_suspend()` and [`zx_debug_resume()`] do not depend on the
    /// `kernel.enable-serial-syscalls` kernel command line option.  They are
    /// gated only by *resource*.
    ///
    /// ## Rights
    ///
    /// *resource* must have resource kind `ZX_RSRC_KIND_SYSTEM` with base
    /// `ZX_RSRC_SYSTEM_DEBUG_BASE`.
    ///
    /// ## Return value
    ///
    /// Returns `ZX_OK` on success.
    ///
    /// ## Errors
    ///
    /// `ZX_ERR_BAD_HANDLE`  *resource* is not a valid handle.
    ///
    /// `ZX_ERR_WRONG_TYPE`  *resource* is not a resource handle.
    ///
    /// `ZX_ERR_OUT_OF_RANGE`  *resource* is not the debug system resource.
    ///
    /// `ZX_ERR_NOT_SUPPORTED`  The system has no debug serial port, or the
    /// kernel has been configured to bypass the debuglog
    /// (`kernel.bypass-debuglog=true`).
    ///
    /// `ZX_ERR_BAD_STATE`  The debug serial port is already suspended, or
    /// another call to `zx_debug_suspend()` is in progress.
    ///
    /// ## See also
    ///
    ///  - [`zx_debug_read()`]
    ///  - [`zx_debug_resume()`]
    ///  - [`zx_debug_write()`]
    ///
    /// [`zx_debug_read()`]: debug_read.md
    /// [`zx_debug_resume()`]: debug_resume.md
    /// [`zx_debug_write()`]: debug_write.md
    @blocking
    @next
    strict Suspend(resource struct {
        resource Handle:RESOURCE;
    }) -> () error Status;

    /// ## Summary
    ///
    /// Allow access to the debug serial port hardware after a successful
    /// [`zx_debug_suspend()`].
    ///
    /// ## Declaration
    ///
    /// ```c
    /// #include <zircon/syscalls-next.h>
    ///
    /// zx_status_t zx_debug_resume(zx_handle_t resource);
    /// ```
    ///
    /// ## Description
    ///
    /// `zx_debug_resume()` undoes the effects of a previous call to
    /// [`zx_debug_suspend()`].  The caller must ensure that the debug serial
    /// port hardware has been powered and clocked before calling
    /// `zx_debug_resume()`.
    ///
    /// Once resumed, any blocked calls to [`zx_debug_write()`] will proceed, and
    /// any log messages recorded while the port was suspended will be emitted.
    ///
    /// ## Rights
    ///
    /// *resource* must have resource kind `ZX_RSRC_KIND_SYSTEM` with base
    /// `ZX_RSRC_SYSTEM_DEBUG_BASE`.
    ///
    /// ## Return value
    ///
    /// Returns `ZX_OK` on success.
    ///
    /// ## Errors
    ///
    /// `ZX_ERR_BAD_HANDLE`  *resource* is not a valid handle.
    ///
    /// `ZX_ERR_WRONG_TYPE`  *resource* is not a resource handle.
    ///
    /// `ZX_ERR_OUT_OF_RANGE`  *resource* is not the debug system resource.
    ///
    /// `ZX_ERR_NOT_SUPPORTED`  The system has no debug serial port, or the
    /// kernel has been configured to bypass the debuglog
    /// (`kernel.bypass-debuglog=true`).
    ///
    /// `ZX_ERR_BAD_STATE`  The debug serial port is not suspended (including
    /// when a call to [`zx_debug_suspend()`] is still in progress).
    ///
    /// ## See also
    ///
    ///  - [`zx_debug_suspend()`]
    ///  - [`zx_debug_write()`]
    ///
    /// [`zx_debug_suspend()`]: debug_suspend.md
    /// [`zx_debug_write()`]: debug_write.md
    @next
    strict Resume(resource struct {
        resource Handle:RESOURCE;
    }) -> () error Status;

    /// ## Summary
    ///
    /// TODO(https://fxbug.dev/42108078)
    ///
    /// ## Declaration
    ///
    /// ```c
    /// #include <zircon/syscalls.h>
    ///
    /// zx_status_t zx_debug_send_command(zx_handle_t resource,
    ///                                   const char* buffer,
    ///                                   size_t buffer_size);
    /// ```
    ///
    /// ## Description
    ///
    /// To use the `zx_debug_send_command()` function, you must specify
    /// `kernel.enable-debugging-syscalls=true` on the kernel command line. Otherwise,
    /// the function returns `ZX_ERR_NOT_SUPPORTED`.
    ///
    /// TODO(https://fxbug.dev/42108078)
    ///
    /// ## Rights
    ///
    /// *resource* must have resource kind `ZX_RSRC_KIND_SYSTEM` with base
    /// `ZX_RSRC_SYSTEM_DEBUG_BASE`.
    ///
    /// ## Return value
    ///
    /// TODO(https://fxbug.dev/42108078)
    ///
    /// ## Errors
    ///
    /// TODO(https://fxbug.dev/42108078)
    ///
    /// ## See also
    ///
    /// TODO(https://fxbug.dev/42108078)
    strict SendCommand(resource struct {
        resource Handle:RESOURCE;
        buffer vector<uchar>:MAX;
    }) -> () error Status;
};
