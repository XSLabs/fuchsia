load(
    "@fuchsia_rules_common//packages:resources.bzl",
    "resource",
)
load(
    "//build/bazel/rules/packages:fx_package.bzl",
    "fx_package",
)

package(default_applicable_licenses = ["//:license"])

fx_package(
    name = "starnix_support.bootfs_files_package",
    package_name = "starnix_support.bootfs_files_package",
    resources = [":starnix_profiles_resource"],
    visibility = ["//bundles/assembly:__subpackages__"],
)

resource(
    name = "starnix_profiles_resource",
    src = "starnix.profiles",
    dest = "config/profiles/starnix.profiles",
)
