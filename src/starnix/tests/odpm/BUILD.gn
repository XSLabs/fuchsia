import("//build/components.gni")
import("//build/rust/rustc_binary.gni")
import("//build/rust/rustc_test.gni")
import("//src/starnix/tests/build/starnix_linux_test_component.gni")
import("//src/starnix/tests/starnix_test_subpackages.gni")

group("tests") {
  testonly = true
  deps = [ ":starnix_odpm_test" ]
}

# Standalone fake ODPM service component
rustc_binary("fake_odpm_bin") {
  testonly = true
  edition = "2024"
  output_name = "fake_odpm"
  source_root = "src/fake_odpm.rs"
  sources = [ "src/fake_odpm.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.google.odpm:fuchsia.hardware.google.odpm_rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
  ]
}

fuchsia_component("fake_odpm") {
  testonly = true
  manifest = "meta/fake_odpm.cml"
  deps = [ ":fake_odpm_bin" ]
}

fuchsia_component("odpm_container") {
  testonly = true
  manifest = "meta/odpm_container.cml"
}

# Linux Rust test binary
rustc_test("odpm_test_bin") {
  edition = "2024"
  source_root = "src/odpm_test.rs"
  sources = [ "src/odpm_test.rs" ]
}

starnix_linux_test_component("odpm_test_component") {
  test_label = ":odpm_test_bin"
  test_binary = "odpm_test_bin"
  manifest = "meta/odpm_test.cml"
  test_type = "starnix"
}

fuchsia_test_package("starnix_odpm_test") {
  test_components = [ ":odpm_test_component" ]
  deps = [
    ":fake_odpm",
    ":odpm_container",
    "//src/starnix/containers/debian:container_resources",
  ]
  subpackages = starnix_test_subpackages
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
