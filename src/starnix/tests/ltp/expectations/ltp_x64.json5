{
    actions: [
        {
            type: "expect_failure",
            matchers: [
                // ioperm() and iopl() syscalls are not implemented in Starnix. Both are specific
                // to x86_64, so these tests are skipped on ARM64 and RISC-V.
                "ioperm01",
                "ioperm02",
                "iopl01",
                "iopl02",

                // TODO(https://fxbug.dev/560397662): Triage the x64-specific tests
                "cve-2018-1000199",
                "cve-2018-8897",
                "prctl10",
                "ptrace10",
                "runpwtests03",
                "runpwtests06",
            ],
        },
    ],
}
