load("//build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

# NOTE: `memory_pinning_tests` remains in BUILD.gn and `with_unit_tests` /
# `test_deps` are synced via bazel2gn because `memory_pinning` transitively
# depends on `//src/storage/lib/vfs/rust:vfs` (`rustc_dylib("vfs_dylib")`).
# `@rules_rust` puts both `src/storage/lib/vfs/rust/libvfs-<hash>.so` and its
# `_solib_*` symlink into `default_runfiles`, causing `fx_packaged_binary` +
# `fx_package` to fail with:
# "Multiple files are being installed into the package at lib/libvfs-<hash>.so".
rustc_library(
    name = "memory_pinning",
    srcs = [
        "src/lib.rs",
        "src/shadow_process.rs",
    ],
    edition = "2024",
    lint_config = "//src/starnix/build:kernel_library_config",
    test_deps = [
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:futures",
    ],
    visibility = ["//src/starnix/kernel/core:__pkg__"],
    with_unit_tests = True,
    deps = [
        "//sdk/fidl/fuchsia.scheduler:fuchsia.scheduler_rust",
        "//sdk/rust/zx",
        "//src/lib/fuchsia-component",
        "//src/lib/fuchsia-runtime",
        "//src/starnix/lib/starnix_logging",
        "//src/starnix/lib/starnix_uapi",
    ],
)
