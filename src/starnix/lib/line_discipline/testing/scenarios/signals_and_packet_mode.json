{
    "name": "signals_and_packet_mode",
    "capture_signals": true,
    "initial_termios": {
        "c_iflag": [
            "ICRNL",
            "IXON"
        ],
        "c_oflag": [
            "OPOST",
            "ONLCR",
            "XTABS"
        ],
        "c_lflag": [
            "ISIG",
            "ICANON",
            "ECHO",
            "ECHOE",
            "ECHOCTL",
            "IEXTEN"
        ]
    },
    "events": [
        {
            "action": "set_packet_mode",
            "enabled": true
        },
        {
            "action": "write_to_master",
            "data": "abc\u0003",
            "expect_signal": true
        },
        {
            "action": "read_once_from_master"
        },
        {
            "action": "read_once_from_master"
        },
        {
            "action": "write_to_master",
            "data": "\u001c",
            "expect_signal": true
        },
        {
            "action": "read_once_from_master"
        },
        {
            "action": "read_once_from_master"
        },
        {
            "action": "write_to_master",
            "data": "\u0013"
        },
        {
            "action": "read_once_from_master"
        },
        {
            "action": "write_to_master",
            "data": "def\u001a",
            "expect_signal": true
        },
        {
            "action": "read_once_from_master"
        },
        {
            "action": "read_once_from_master"
        },
        {
            "action": "write_to_master",
            "data": "\t\n"
        },
        {
            "action": "read_once_from_master"
        },
        {
            "action": "read_once_from_slave"
        },
        {
            "action": "set_packet_mode",
            "enabled": false
        },
        {
            "action": "set_termios",
            "termios": {
                "c_iflag": [
                    "ICRNL",
                    "IXON"
                ],
                "c_oflag": [
                    "OPOST",
                    "ONLCR",
                    "XTABS"
                ],
                "c_lflag": [
                    "ISIG"
                ]
            }
        },
        {
            "action": "write_to_master",
            "data": "\u0003"
        },
        {
            "action": "read_once_from_slave",
            "expect_signal": true
        }
    ]
}
