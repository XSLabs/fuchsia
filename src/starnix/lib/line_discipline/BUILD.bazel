    "echonl_echoprt",
    "echoprt_backspace_multi_aln",
    "echoprt_backspace_multi_nl",
    "echoprt_backspace_multi_space",
    "echoprt_backspace_nl_aln",
    "echoprt_backspace_nl_nl",
    "echoprt_backspace_nl_space",
    "echoprt_kill",
    "echoprt_kill_nl_aln",
    "echoprt_word_erase",
    "echoprt_word_erase_nl_aln",
    "echoprt_word_erase_nl_nl",
    "echoprt_word_erase_space",
    "echoprt_word_erase_tab",
    "echoprt_word_erase_typing",
    "flush_sigint",
    "flush_sigint_after_newline",
    "flush_sigint_after_newline_separate_writes",
    "flush_sigquit",
    "flush_sigsusp",
    "input_icrnl_prec",
    "input_igncr",
    "input_inlcr",
    "input_inlcr_icrnl_swap",
    "iuclc_simple",
