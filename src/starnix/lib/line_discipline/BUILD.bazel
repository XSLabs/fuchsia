load("//build/bazel/rules/rust:defs.bzl", "rustc_library", "rustc_test")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "line_discipline",
    srcs = [
        "lib.rs",
        "testing/mod.rs",
    ],
    crate_root = "lib.rs",
    edition = "2024",
    proc_macro_deps = ["//third_party/rust_crates/vendor:derivative"],
    test_deps = ["//src/lib/fuchsia"],
    visibility = ["//src/starnix/kernel/core:__pkg__"],
    with_unit_tests = True,
    deps = [
        "//src/starnix/lib/starnix_uapi",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:utf8parse",
    ],
)

# Note: testing/scenarios_list.json is strict JSON parsed by GN's read_file()
# and Python's json.load(), so it cannot contain LINT.IfChange comments.
# @bazel2gn:skip
