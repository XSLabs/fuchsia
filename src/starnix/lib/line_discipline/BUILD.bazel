    "noflsh_sigint",
    "noflsh_sigquit",
    "noflsh_sigsusp",
    "olcuc_simple",
    "output_direct_ocrnl",
    "output_direct_onlret_onocr",
    "output_ocrnl",
    "output_ocrnl_explicit",
    "output_onlret",
    "output_onocr",
    "output_xtabs",
    "packet_mode_basic",
    "tcflush_packet_mode",
    "tciflush",
    "tciflush_buffer_full",
    "tciflush_canon",
    "tcioflush",
    "tcioflush_canon",
    "tcoflush",
    "vdiscard_basic",
    "veol2_basic",
    "veol2_no_iexten",
    "veol_basic",
    "vlnext_basic",
