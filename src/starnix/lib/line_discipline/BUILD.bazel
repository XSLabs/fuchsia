# @bazel2gn:skip
genrule(
    name = "generate_scenarios_rs",
    srcs = ["testing/generated/%s.json" % s for s in _SCENARIOS] + [
        "testing/trace_generator.py",
    ],
    outs = ["testing/scenarios.rs"],
    # The traces are checked-in sources, not build outputs. Genrule commands
    # run from the execution root, where this package's sources are under
    # package_name().
    cmd = "python3 $(location testing/trace_generator.py) --generate-rs --output $@ --trace-dir " + package_name() + "/testing/generated --names " + " ".join(_SCENARIOS),
)

rustc_test(
    name = "line_discipline_scenarios_test",
    srcs = [
        ":testing/scenarios.rs",  # @bazel2gn:path_overwrite:$target_gen_dir/testing/scenarios.rs
    ],
    crate_root = ":testing/scenarios.rs",  # @bazel2gn:raw_overwrite:"$target_gen_dir/testing/scenarios.rs"
    data = [":generate_scenarios_rs"],
    edition = "2024",
    deps = [
        ":line_discipline",
        "//third_party/rust_crates/vendor:test-case",
    ],
)
