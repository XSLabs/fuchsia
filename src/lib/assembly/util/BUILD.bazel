load("//build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "util",
    srcs = [
        "src/fast_copy.rs",
        "src/insert_unique.rs",
        "src/lib.rs",
        "src/named_map.rs",
        "src/paths.rs",
    ],
    crate_name = "assembly_util",
    edition = "2024",
    test_deps = [
        "//third_party/rust_crates/vendor:serial_test",
        "//third_party/rust_crates/vendor:tempfile",
