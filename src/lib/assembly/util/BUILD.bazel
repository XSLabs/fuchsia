    visibility = [
        "//build/assembly/tools/assembly:__pkg__",
        "//build/assembly/tools/assembly_config:__pkg__",
        "//build/assembly/tools/mos_tool:__pkg__",
        "//src/developer/ffx/plugins:__subpackages__",
        "//src/lib/assembly:__subpackages__",
    ],
    with_host_unit_tests = True,
    deps = [
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:camino",
        "//third_party/rust_crates/vendor:pathdiff",
        "//third_party/rust_crates/vendor:regex",
        "//third_party/rust_crates/vendor:schemars",
        "//third_party/rust_crates/vendor:serde",
        "//third_party/rust_crates/vendor:serde_json",
        "//third_party/rust_crates/vendor:serde_json5",
        "//third_party/rust_crates/vendor:walkdir",
        "//third_party/rust_crates/vendor:xattr",
    ],
