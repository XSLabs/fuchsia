load(
    "//build/bazel/rules/components:fx_component.bzl",
    "fx_component_manifest",
    "fx_test_component",
)
load("//build/bazel/rules/host_tests:host_rustc_test.bzl", "wrap_host_rust_test")
load("//build/bazel/rules/packages:fx_package.bzl", "fx_package")
load("//build/bazel/rules/packages:fx_packaged_binary.bzl", "fx_packaged_binary")
load("//build/bazel/rules/rust:defs.bzl", "rustc_library", "rustc_test")
load("//build/bazel/rules/testing:fx_test.bzl", "fx_test")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "replace-with",
    srcs = ["src/lib.rs"],
    edition = "2024",
    visibility = [
        "//src/connectivity/network/netstack3:__subpackages__",
        "//src/developer/adb/bin/adb-sideload:__pkg__",
        "//src/lib/fdomain/container:__pkg__",
        "//src/lib/network/packet:__pkg__",
        "//src/starnix/kernel/core:__pkg__",
        "//vendor/google:__subpackages__",
    ],
)

# @bazel2gn:skip
rustc_test(
    name = "replace-with_lib_test",
    crate = ":replace-with",
    edition = "2024",
)

# @bazel2gn:skip
wrap_host_rust_test(
    name = "replace-with-host_test",
    binary_name = "replace-with_lib_test",
)

fx_packaged_binary(
    name = "replace-with_lib_test_packaged_bin",
    testonly = True,
    binary = ":replace-with_lib_test",
    binary_name = "replace-with_lib_test",
)

fx_component_manifest(
    name = "replace-with-test-manifest",
    testonly = True,
    component_name = "replace-with-test",
    includes = [
        "//sdk/lib/syslog:use.shard.cml",
        "//src/sys/test_runners/rust:default.shard.cml",
    ],
    manifest = "meta/replace_with_test.cml",
)

fx_test_component(
    name = "replace-with-test-component",
    compiled_manifest = ":replace-with-test-manifest",
    component_name = "replace-with-test",
    deps = [":replace-with_lib_test_packaged_bin"],
)

fx_package(
    name = "replace-with-test-package",
    package_name = "replace-with-test",
    test_components = [":replace-with-test-component"],
)

fx_test(
    name = "replace-with-test",
    package = ":replace-with-test-package",
)
