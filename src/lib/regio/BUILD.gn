import("//build/components.gni")
import("//build/rust/rustc_library.gni")

rustc_library("regio") {
  edition = "2024"
  with_unit_tests = true
  sources = [
    "src/lib.rs",
    "src/mmio.rs",
    "src/x86/mod.rs",
    "src/x86/msr.rs",
  ]
  deps = [ "//zircon/system/ulib/mmio-ptr:mmio-ptr-rs" ]
}

fuchsia_unittest_package("regio-tests") {
  deps = [ ":regio_test" ]
}

group("tests") {
  testonly = true
  deps = [
    ":regio-tests",
    ":regio_test($host_toolchain)",
  ]
}
