rustc_macro("fuchsia-rcu-derive") {
  sources = [ "macro/src/lib.rs" ]
  source_root = "macro/src/lib.rs"
  edition = "2024"
  deps = [
    "//third_party/rust_crates:proc-macro2",
    "//third_party/rust_crates:quote",
    "//third_party/rust_crates:syn",
  ]
}
rustc_library("fuchsia-rcu") {
  sources = [
    "src/atomic_stack.rs",
    "src/lib.rs",
    "src/rcu_arc.rs",
    "src/rcu_box.rs",
    "src/rcu_droppable.rs",
    "src/rcu_droppable_arc.rs",
    "src/rcu_option_arc.rs",
    "src/rcu_option_box.rs",
    "src/rcu_ptr.rs",
    "src/rcu_read_scope.rs",
    "src/rcu_weak.rs",
    "src/read_counters.rs",
    "src/state_machine.rs",
  ]
  edition = "2024"
  proc_macro_deps = [ ":fuchsia-rcu-derive" ]
  version = "0.1.0"
  with_unit_tests = true
  deps = [
    "//sdk/rust/zx",
    "//src/lib/fuchsia-runtime",
    "//src/lib/fuchsia-sync",
    "//src/lib/shared-buffer",
    "//src/lib/trace/rust:trace",
    "//third_party/rust_crates:bstr",
    "//third_party/rust_crates:futures",
  ]
}
