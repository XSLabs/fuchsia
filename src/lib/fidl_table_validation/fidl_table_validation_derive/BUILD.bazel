load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/rules/rust:defs.bzl", "rustc_proc_macro")

package(default_applicable_licenses = ["//:license"])

rustc_proc_macro(
    name = "fidl_table_validation_derive",
    srcs = ["src/lib.rs"],
    edition = "2024",
    # @bazel2gn:skip
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//src/lib/fidl_table_validation:__pkg__"],
    deps = [
        "//third_party/rust_crates/vendor:heck",
        "//third_party/rust_crates/vendor:itertools",
        "//third_party/rust_crates/vendor:proc-macro2",
        "//third_party/rust_crates/vendor:quote",
        "//third_party/rust_crates/vendor:syn",
