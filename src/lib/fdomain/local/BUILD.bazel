load("//build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "local",
    srcs = ["src/lib.rs"],
    crate_name = "fdomain_local",
    edition = "2024",
    test_deps = ["//src/lib/fuchsia"],
    visibility = ["//visibility:public"],
    with_unit_tests = True,
    deps = [
        "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
        "//src/lib/fdomain/client",
        "//src/lib/fdomain/container",
        "//src/lib/fidl/rust/fidl",
        "//src/lib/fuchsia-async",
        "//third_party/rust_crates/vendor:futures",
    ],
)

rustc_library(
    name = "local_fdomain_flex",
    srcs = ["src/flex.rs"],
    crate_features = ["fdomain"],
    crate_name = "flex_local",
    crate_root = "src/flex.rs",
    edition = "2024",
    visibility = [
        "//src/connectivity/network/net-cli:__pkg__",
        "//src/lib/network/fidl_fuchsia_net_filter_ext:__pkg__",
        "//src/lib/network/fidl_fuchsia_net_interfaces_ext:__pkg__",
        "//src/storage/lib/vfs/rust:__pkg__",
    ],
    with_unit_tests = True,
    deps = [":local"],
)

rustc_library(
    name = "local_fidl_flex",
    srcs = ["src/flex.rs"],
    crate_name = "flex_local",
    crate_root = "src/flex.rs",
    edition = "2024",
    visibility = [
        "//src/connectivity/network/net-cli:__pkg__",
        "//src/lib/network/fidl_fuchsia_net_filter_ext:__pkg__",
        "//src/lib/network/fidl_fuchsia_net_interfaces_ext:__pkg__",
        "//src/storage/lib/vfs/rust:__pkg__",
    ],
    with_unit_tests = True,
    deps = ["//src/lib/fidl/rust/fidl"],
)
