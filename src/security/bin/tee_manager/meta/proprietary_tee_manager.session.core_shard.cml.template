{
    children: [
        {
            name: "tee_manager",
            url: "{{COMPONENT_URL}}",
        },
    ],
    expose: [
        {
            protocol: [
                "fuchsia.security.keymint.Admin",
                "fuchsia.security.keymint.SealingKeys",
            ],
            from: "#tee_manager",
        },
    ],
    offer: [
        {
            service: "fuchsia.hardware.tee.proprietary.Service",
            from: "parent",
            to: "#tee_manager",
            availability: "same_as_target",
        },
        {
            service: "fuchsia.hardware.rpmb.Service",
            from: "parent",
            to: "#tee_manager",
            availability: "same_as_target",
        },
        {
            // TODO(https://fxbug.dev/540953983): switch to accessing only the partitions of interest.
            service: "fuchsia.storage.partitions.PartitionService",
            from: "parent",
            to: "#tee_manager",
            availability: "same_as_target",
        },
        {
            storage: "data",
            from: "self",
            to: "#tee_manager",
        },
        {
            dictionary: "tee_session",
            from: "#tee_manager",
            to: "#session-manager",
        },
    ],
}
