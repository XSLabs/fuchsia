load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")
load("//build/bazel/platforms:constraints.bzl", "HOST_OS_CONSTRAINTS")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "far",
    srcs = ["far.go"],
    importpath = "go.fuchsia.dev/fuchsia/src/sys/pkg/lib/far/go",
    target_compatible_with = HOST_OS_CONSTRAINTS,  # @bazel2gn:skip
    visibility = [
        "//src/sys/pkg/lib/far:__pkg__",
        "//src/testing/host-target-testing/build:__pkg__",
        "//src/testing/host-target-testing/packages:__pkg__",
    ],
)

go_test(
    name = "go_far_test",
    srcs = [
        "far_test.go",
        "reject_invalid_fars_test.go",
    ],
    embed = [":far"],
    target_compatible_with = HOST_OS_CONSTRAINTS,  # @bazel2gn:skip
)
