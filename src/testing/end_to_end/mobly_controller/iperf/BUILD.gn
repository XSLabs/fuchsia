import("//build/python/python_library.gni")

python_library("iperf") {
  testonly = true
  library_name = "iperf"
  source_root = "."
  sources = [
    "__init__.py",
    "iperf_client.py",
    "iperf_server.py",
  ]
  library_deps = [
    "//src/testing/end_to_end/libs",
    "//third_party/mobly",
  ]
}

group("tests") {
  testonly = true
  deps = [ "tests" ]
}
