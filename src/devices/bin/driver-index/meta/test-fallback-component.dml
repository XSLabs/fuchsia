{
    name: "test-fallback-component",
    program: {
        binary: "driver/fake-fallback-driver.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        fallback: "true",
        bind: {
            rules: { "fuchsia.BIND_PROTOCOL": 1 },
        },
    },
}
