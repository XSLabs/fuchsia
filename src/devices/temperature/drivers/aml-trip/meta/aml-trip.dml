{
    name: "aml-trip",
    program: {
        default_dispatcher_opts: [ "allow_sync_calls" ],
        host_restart_on_crash: "true",
    },
    capabilities: [
        { service: "fuchsia.hardware.temperature.Service" },
        {
            driver_config: "fuchsia.hardware.trippoint.TripDeviceMetadata",
            properties: {
                critical_temp_celsius: { type: "uint32" },
            },
        },
    ],
    use: [
        {
            name: "pdev",
            service: "fuchsia.hardware.platform.device.Service",
            primary: true,
            bind: {
                one_of: [
                    {
                        compat: "amlogic,g12a-thermal",
                        did: "fuchsia.platform.BIND_PLATFORM_DEV_DID.DEVICETREE",
                        vid: "fuchsia.platform.BIND_PLATFORM_DEV_VID.GENERIC",
                    },
                    {
                        protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
                        vid: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_VID.AMLOGIC",
                        pid: "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_PID.A311D",
                        did: [
                            "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_DID.TEMP_SENSOR_DDR",
                            "fuchsia.amlogic.platform.BIND_PLATFORM_DEV_DID.TEMP_SENSOR_PLL",
                        ],
                    },
                ],
            },
        },
        {
            name: "clock-init",
            service: "fuchsia.clock.Init",
            availability: "optional",
        },
        { service: "fuchsia.hardware.platform.bus.Service" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.temperature.Service",
            from: "self",
        },
    ],
}
