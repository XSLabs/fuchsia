@available(added=HEAD)
library fuchsia.board.dml.config;

using fuchsia.driver.metadata as fdr;

/// Metadata that is statically defined in the board configuration and passed
/// to the device.
type StaticMetadata = table {
    1: id string:MAX;
    2: data vector<uint8>:MAX;
};

type Device = table {
    1: name string:MAX;
    2: id uint32;
    3: url string:MAX;
    4: compatible string:MAX;
    5: metadata vector<StaticMetadata>:MAX;
    6: interrupt_controller_id uint32;
    7: disabled bool;
    8: driver_host string:MAX;
};

type ResourceEntry = table {
    1: node string:MAX;
    2: constraint fdr.Dictionary;
    3: name string:MAX;
};

type AggregateEntry = table {
    1: provider string:MAX;
    2: service string:MAX;
    3: resources vector<ResourceEntry>:MAX;
};

type StubIommu = struct {};

type ArmSmmu = struct {
    base_address uint64;
};

type IommuType = flexible union {
    1: stub_iommu StubIommu;
    2: arm_smmu ArmSmmu;
};

type Iommu = table {
    1: name string:MAX;
    2: id uint32;
    3: iommu_type IommuType;
};

type BoardConfig = table {
    1: devices vector<Device>:MAX;
    2: aggregates vector<AggregateEntry>:MAX;
    3: iommus vector<Iommu>:MAX;
};
