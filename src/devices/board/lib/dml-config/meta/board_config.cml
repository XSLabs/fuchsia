{
    use: [
        {
            config: "fuchsia.driver.devicetree.EnabledNodes",
            key: "enabled_nodes",
            type: "vector",
            max_count: 50,
            element: {
                type: "string",
                max_size: 100,
            },
            availability: "optional",
            default: [],
        },
    ],
}
