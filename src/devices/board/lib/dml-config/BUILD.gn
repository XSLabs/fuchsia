import("//build/components.gni")
import("//build/fidl/fidl.gni")
import("//build/rust/rustc_library.gni")

fidl("fuchsia.board.dml.config") {
  sources = [ "fidl/config.fidl" ]
  public_deps = [ "//sdk/fidl/fuchsia.driver.metadata" ]
}

if (is_fuchsia) {
  fuchsia_component_manifest("board-config-manifest") {
    component_name = "board-config"
    manifest = "meta/board_config.cml"
  }

  fuchsia_structured_config_rust_lib("board_structured_config") {
    cm_label = ":board-config-manifest"
  }
}

rustc_library("dml-config") {
  edition = "2024"
  name = "dml_config"
  with_unit_tests = true
  source_root = "src/lib.rs"
  sources = [
    "src/lib.rs",
    "src/parser.rs",
  ]
  deps = [
    ":fuchsia.board.dml.config_rust",
    "//sdk/fidl/fuchsia.driver.metadata:fuchsia.driver.metadata_rust",
    "//third_party/rust_crates:anyhow",
  ]
  if (is_fuchsia) {
    deps += [
      ":board_structured_config",
      "//sdk/fidl/fuchsia.driver.framework:fuchsia.driver.framework_rust_next",
      "//sdk/fidl/fuchsia.hardware.platform.bus:fuchsia.hardware.platform.bus_rust_next",
      "//sdk/fidl/fuchsia.hardware.power:fuchsia.hardware.power_rust_next",
      "//sdk/lib/driver/runtime/rust/fidl",
      "//sdk/rust/zx",
      "//src/lib/fidl/rust_next/fidl_next",
      "//third_party/rust_crates:futures",
      "//third_party/rust_crates:log",
      "//third_party/rust_crates:phf",
    ]
  }
}
