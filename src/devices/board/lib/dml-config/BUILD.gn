import("//build/fidl/fidl.gni")
import("//build/rust/rustc_library.gni")

fidl("fuchsia.board.dml.config") {
  sources = [ "fidl/config.fidl" ]
  public_deps = [ "//sdk/fidl/fuchsia.driver.metadata" ]
}

rustc_library("dml-config") {
  edition = "2024"
  name = "dml_config"
  source_root = "src/lib.rs"
  sources = [ "src/lib.rs" ]
  deps = [
    ":fuchsia.board.dml.config_rust",
    "//sdk/fidl/fuchsia.driver.metadata:fuchsia.driver.metadata_rust",
  ]
}
