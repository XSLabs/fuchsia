{
    include: [
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "driver",
        binary: "driver/usb-zero-function.so",
        bind: "meta/bind/usb-zero-function.bindbc",
        colocate: "true",
    },
    use: [
        { service: "fuchsia.hardware.usb.function.UsbFunctionService" },
    ],
}
