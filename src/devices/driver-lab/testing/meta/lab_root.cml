{
    include: [
        "driver_component/driver.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "driver",
        binary: "driver/lab_root.so",
        bind: "meta/bind/lab_root.bindbc",
    },
    capabilities: [
        { service: "fuchsia.hardware.platform.device.Service" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.platform.device.Service",
            from: "self",
        },
    ],
}
