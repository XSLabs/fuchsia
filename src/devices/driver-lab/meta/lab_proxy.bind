// The proxy binds only to nodes explicitly marked as proxy targets.
// No production node carries this property, so the proxy can never
// bind opportunistically.
using fuchsia.driver.lab;

fuchsia.driver.lab.PROXY_TARGET == fuchsia.driver.lab.PROXY_TARGET.SELECTED;
