import("//build/components.gni")
import("//build/rust/rustc_test.gni")
import("//build/testing/environments.gni")

rustc_test("spi_integration_test") {
  edition = "2024"
  source_root = "src/lib.rs"
  sources = [ "src/lib.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.spi:fuchsia.hardware.spi_rust",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-fs",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
  ]
}

fuchsia_test_component("spi_integration_test_component") {
  manifest = "meta/spi-integration-test.cml"
  deps = [ ":spi_integration_test" ]
  test_type = "driver_system"
}

fuchsia_test_package("spi-integration-test") {
  test_components = [ ":spi_integration_test_component" ]
  test_specs = {
    environments = [ iris_env ]
  }
}
