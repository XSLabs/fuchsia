{
  name: "fake-device",
  include: [
    "driver_component/driver.shard.cml"
  ],
  program: {
    colocate: "true"
  },
  use: [
    {
      name: "pdev",
      primary: true,
      service: "fuchsia.hardware.platform.device.Service",
      requirements: {
        protocol: "fuchsia.platform.BIND_PROTOCOL.DEVICE",
        compat: "fake,device"
      }
    },
    {
      name: "my-clock",
      service: "fuchsia.hardware.clock.Service",
      requirements: {
        rules: {
          "fuchsia.NAME": "\"my-clock\""
        }
      }
    }
  ]
}
