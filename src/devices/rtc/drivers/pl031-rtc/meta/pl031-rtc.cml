{
    include: [
        "driver/platform-device.shard.cml",
        "driver_component/driver.shard.cml",
    ],
    program: {
        binary: "driver/pl031-rtc.so",
        bind: "meta/bind/pl031_rtc_bind.bindbc",
    },
    capabilities: [
        { service: "fuchsia.hardware.rtc.Service" },
    ],
    expose: [
        {
            service: "fuchsia.hardware.rtc.Service",
            from: "self",
        },
    ],
}
