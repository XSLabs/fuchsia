import("//build/bazel/export_fuchsia_package_to_bazel.gni")
import("//build/components.gni")
import("//build/rust/rustc_binary.gni")

rustc_binary("bin") {
  output_name = "power_stats_util"
  edition = "2024"
  with_unit_tests = true
  sources = [ "src/main.rs" ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.power.stats:fuchsia.hardware.power.stats_rust",
    "//sdk/fidl/fuchsia.io:fuchsia.io_rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//src/lib/fuchsia-fs",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
  ]
}

fuchsia_package("power_stats_util") {
  package_name = "power_stats_util"
  deps = [ ":bin" ]
}

export_fuchsia_package_to_bazel("power_stats_util_export") {
  package = ":power_stats_util"
}

fuchsia_unittest_package("power_stats_util_unit_test") {
  deps = [ ":bin_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":power_stats_util_unit_test" ]
}
