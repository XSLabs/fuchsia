import("//build/python/python_library.gni")

python_library("usb_lib") {
  testonly = true
  library_name = "usb_lib"
  sources = [
    "__init__.py",
    "fastboot_utils.py",
    "sysfs_usb.py",
    "usb_config.py",
    "usb_power_hub_base_test.py",
  ]
  library_deps = [
    "//sdk/fidl/fuchsia.hardware.power.statecontrol:fuchsia.hardware.power.statecontrol_python",
    "//src/testing/end_to_end/honeydew",
    "//src/testing/end_to_end/mobly_base_tests/fuchsia_base_test",
  ]
}

group("tests") {
  testonly = true
  public_deps = [
    "testusb:tests",
    "zero_function:tests",
  ]
}
