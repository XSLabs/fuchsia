{
    name: "bind",
    composite_name: "mali_csf",
    include: [ "driver/platform-device.shard.cml" ],
    program: {
        binary: "driver/driver.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
    },
    use: [
        {
            name: "pdev",
            primary: true,
            bind: { compat: "arm,mali-valhall" },
        },
    ],
}
