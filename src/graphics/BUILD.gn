import("//build/bazel/bazel_test_suite.gni")

group("graphics") {
  deps = [
    "drivers",
    "lib",
  ]
}

group("tests") {
  testonly = true
  deps = [
    ":bazel_tests",
    "bin/agis:agis-test",
    "bin/vulkan_loader:tests",
    "display:tests",
    "drivers:tests",
    "lib/compute:tests",
    "magma:tests",
    "tests",
  ]
}

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/graphics:host_tests" ]
  target_tests = [ "//src/graphics:target_tests" ]
}
