import("//build/components.gni")
import("//build/rust/rustc_binary.gni")

rustc_binary("bin") {
  output_name = "memory_pressure_signaler"
  edition = "2024"
  with_unit_tests = true

  sources = [
    "src/main.rs",
    "src/pressure_notifier.rs",
    "src/pressure_observer.rs",
  ]

  deps = [
    "//sdk/fidl/fuchsia.feedback:fuchsia.feedback_rust",
    "//sdk/fidl/fuchsia.kernel:fuchsia.kernel_rust",
    "//sdk/fidl/fuchsia.memory.debug:fuchsia.memory.debug_rust",
    "//sdk/fidl/fuchsia.memorypressure:fuchsia.memorypressure_rust",
    "//sdk/rust/zx",
    "//src/lib/fidl/rust/fidl",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-async",
    "//src/lib/fuchsia-component",
    "//src/lib/trace/rust:trace",
    "//src/lib/trace/rust:trace-provider",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:futures",
    "//third_party/rust_crates:log",
  ]
}

fuchsia_component_manifest("memory_pressure_signaler_manifest") {
  component_name = "memory_pressure_signaler"
  manifest = "meta/memory_pressure_signaler.cml"
}

fuchsia_component("component") {
  cm_label = ":memory_pressure_signaler_manifest"
  deps = [ ":bin" ]
}

fuchsia_package("pressure_signaler") {
  package_name = "memory_pressure_signaler"
  deps = [ ":component" ]
}

fuchsia_unittest_package("memory_pressure_signaler_tests") {
  deps = [ ":bin_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":memory_pressure_signaler_tests" ]
}
