import("//build/components.gni")
import("//build/rust/rustc_binary.gni")
import("//build/rust/rustc_library.gni")

group("tests") {
  testonly = true
  deps = [ ":fdomain-uart-driver-tests" ]
}

rustc_library("lib") {
  name = "fdomain_uart_driver_lib"
  edition = "2024"
  with_unit_tests = true

  deps = [
    "//src/developer/lib/uart_fpl",
    "//src/lib/fidl/rust/fidl",
    "//third_party/rust_crates:thiserror",
  ]

  sources = [
    "src/error.rs",
    "src/lib.rs",
  ]
}

rustc_binary("bin") {
  output_name = "fdomain_uart_driver"
  edition = "2024"

  deps = [
    ":lib",
    "//src/lib/fuchsia",
  ]

  sources = [ "src/main.rs" ]
}

fuchsia_component("component") {
  component_name = "fdomain-uart-driver"
  manifest = "meta/fdomain_uart_driver.cml"
  deps = [ ":bin" ]
}

fuchsia_unittest_package("fdomain-uart-driver-tests") {
  deps = [ ":lib_test" ]
}
