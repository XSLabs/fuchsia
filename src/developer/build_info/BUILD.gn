import("//build/bazel/bazel_test_suite.gni")
import("//build/components.gni")
import("//build/rust/rustc_binary.gni")

rustc_binary("shell_bin") {
  name = "build-info"
  edition = "2024"

  deps = [
    "//sdk/fidl/fuchsia.buildinfo:fuchsia.buildinfo_rust",
    "//src/lib/fuchsia",
    "//src/lib/fuchsia-component",
    "//third_party/rust_crates:anyhow",
    "//third_party/rust_crates:argh",
    "//third_party/rust_crates:futures",
  ]

  sources = [ "shell.rs" ]
  source_root = "shell.rs"
}

fuchsia_package_with_single_component("build-info-shell") {
  manifest = "meta/build_info_shell.cml"
  deps = [ ":shell_bin" ]
}

bazel_test_suite("build-info-unittest") {
  target_tests = [ "//src/developer/build_info:build-info-unittest" ]
}

group("tests") {
  testonly = true
  deps = [
    ":build-info-unittest",
    "testing:tests",
  ]
}
