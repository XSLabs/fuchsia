{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "ShowCmdInstance",
    "type": "object",
    "properties": {
        "moniker": {
            "$ref": "#/definitions/Moniker"
        },
        "url": {
            "type": "string"
        },
        "environment": {
            "type": [
                "string",
                "null"
            ]
        },
        "instance_id": {
            "type": [
                "string",
                "null"
            ]
        },
        "resolved": {
            "anyOf": [
                {
                    "$ref": "#/definitions/ShowCmdResolvedInfo"
                },
                {
                    "type": "null"
                }
            ]
        }
    },
    "required": [
        "moniker",
        "url"
    ],
    "definitions": {
        "Moniker": {
            "type": "string"
        },
        "ShowCmdResolvedInfo": {
            "type": "object",
            "properties": {
                "resolved_url": {
                    "type": "string"
                },
                "merkle_root": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "runner": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "incoming_capabilities": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "exposed_capabilities": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "config": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "items": {
                        "$ref": "#/definitions/ConfigField"
                    }
                },
                "started": {
                    "anyOf": [
                        {
                            "$ref": "#/definitions/ShowCmdExecutionInfo"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "collections": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "manifest_sources": {
                    "type": [
                        "array",
                        "null"
                    ],
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "resolved_url",
                "incoming_capabilities",
                "exposed_capabilities",
                "collections"
            ]
        },
        "ConfigField": {
            "description": "A single structured configuration key-value pair.",
            "type": "object",
            "properties": {
                "key": {
                    "type": "string"
                },
                "value": {
                    "type": "string"
                }
            },
            "required": [
                "key",
                "value"
            ]
        },
        "ShowCmdExecutionInfo": {
            "type": "object",
            "properties": {
                "runtime": {
                    "$ref": "#/definitions/Runtime"
                },
                "outgoing_capabilities": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "start_reason": {
                    "type": "string"
                }
            },
            "required": [
                "runtime",
                "outgoing_capabilities",
                "start_reason"
            ]
        },
        "Runtime": {
            "oneOf": [
                {
                    "type": "string",
                    "enum": [
                        "Unknown"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "Elf": {
                            "type": "object",
                            "properties": {
                                "job_id": {
                                    "type": "integer",
                                    "format": "uint64",
                                    "minimum": 0
                                },
                                "process_id": {
                                    "type": [
                                        "integer",
                                        "null"
                                    ],
                                    "format": "uint64",
                                    "minimum": 0
                                },
                                "process_start_time": {
                                    "type": [
                                        "integer",
                                        "null"
                                    ],
                                    "format": "int64"
                                },
                                "process_start_time_utc_estimate": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                }
                            },
                            "required": [
                                "job_id"
                            ]
                        }
                    },
                    "required": [
                        "Elf"
                    ],
                    "additionalProperties": false
                }
            ]
        }
    }
}
