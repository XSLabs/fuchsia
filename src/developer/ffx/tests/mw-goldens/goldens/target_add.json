{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "CommandStatus",
    "oneOf": [
        {
            "description": "Successful execution with an optional informational string.",
            "type": "object",
            "properties": {
                "Ok": {
                    "type": "object",
                    "properties": {
                        "message": {
                            "type": [
                                "string",
                                "null"
                            ]
                        }
                    }
                }
            },
            "required": [
                "Ok"
            ],
            "additionalProperties": false
        },
        {
            "description": "Unexpected error with string.",
            "type": "object",
            "properties": {
                "UnexpectedError": {
                    "type": "object",
                    "properties": {
                        "message": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "message"
                    ]
                }
            },
            "required": [
                "UnexpectedError"
            ],
            "additionalProperties": false
        },
        {
            "description": "A known kind of error that can be reported usefully to the user",
            "type": "object",
            "properties": {
                "UserError": {
                    "type": "object",
                    "properties": {
                        "message": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "message"
                    ]
                }
            },
            "required": [
                "UserError"
            ],
            "additionalProperties": false
        }
    ]
}
