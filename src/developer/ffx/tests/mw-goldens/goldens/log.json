{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "CommandOutput",
    "description": "The schema of `ffx --machine json log`.\n\nThis is the representation of a `diagnostics_data::Data<Logs>` struct.\n\nTo prevent having an over-inflated schema definition, output is not implementing for\n`diagnostics_data::Data<T>` for all `T` as it would include many unused structures.",
    "type": "object",
    "properties": {
        "data": {
            "$ref": "#/definitions/LogData"
        }
    },
    "required": [
        "data"
    ],
    "definitions": {
        "LogData": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "TargetLog": {
                            "$ref": "#/definitions/LogsData"
                        }
                    },
                    "required": [
                        "TargetLog"
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "LogsData": {
            "type": "object",
            "properties": {
                "data_source": {
                    "$ref": "#/definitions/DataSource"
                },
                "metadata": {
                    "$ref": "#/definitions/LogsMetadata"
                },
                "moniker": {
                    "type": "string"
                },
                "payload": {
                    "anyOf": [
                        {
                            "$ref": "#/definitions/DiagnosticsHierarchy"
                        },
                        {
                            "type": "null"
                        }
                    ]
                },
                "version": {
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                }
            },
            "required": [
                "data_source",
                "metadata",
                "moniker",
                "version"
            ]
        },
        "DataSource": {
            "description": "The source of diagnostics data",
            "type": "string",
            "enum": [
                "Unknown",
                "Inspect",
                "Logs"
            ]
        },
        "LogsMetadata": {
            "description": "The metadata contained in a `DiagnosticsData` object where the data source is\n`DataSource::Logs`.",
            "type": "object",
            "properties": {
                "errors": {
                    "description": "Optional vector of errors encountered by platform.",
                    "type": [
                        "array",
                        "null"
                    ],
                    "items": {
                        "$ref": "#/definitions/LogError"
                    }
                },
                "component_url": {
                    "description": "The url with which the component was launched.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "timestamp": {
                    "description": "Boot time in nanos.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/integer"
                        }
                    ]
                },
                "severity": {
                    "description": "Severity of the message.",
                    "allOf": [
                        {
                            "$ref": "#/definitions/Severity"
                        }
                    ]
                },
                "raw_severity": {
                    "description": "Raw severity if any. This will typically be unset unless the log message carries a severity\nthat differs from the standard values of each severity.",
                    "type": [
                        "integer",
                        "null"
                    ],
                    "format": "uint8",
                    "minimum": 0,
                    "maximum": 255
                },
                "tags": {
                    "description": "Tags to add at the beginning of the message",
                    "type": [
                        "array",
                        "null"
                    ],
                    "items": {
                        "type": "string"
                    }
                },
                "pid": {
                    "description": "The process ID",
                    "type": [
                        "integer",
                        "null"
                    ],
                    "format": "uint64",
                    "minimum": 0
                },
                "tid": {
                    "description": "The thread ID",
                    "type": [
                        "integer",
                        "null"
                    ],
                    "format": "uint64",
                    "minimum": 0
                },
                "file": {
                    "description": "The file name",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "line": {
                    "description": "The line number",
                    "type": [
                        "integer",
                        "null"
                    ],
                    "format": "uint64",
                    "minimum": 0
                }
            },
            "required": [
                "timestamp",
                "severity"
            ]
        },
        "LogError": {
            "description": "Possible errors that can come in a `DiagnosticsData` object where the data source is\n`DataSource::Logs`.",
            "oneOf": [
                {
                    "description": "Represents the number of logs that were dropped by the component writing the logs due to an\nerror writing to the socket before succeeding to write a log.",
                    "type": "object",
                    "properties": {
                        "dropped_logs": {
                            "type": "object",
                            "properties": {
                                "count": {
                                    "type": "integer",
                                    "format": "uint64",
                                    "minimum": 0
                                }
                            },
                            "required": [
                                "count"
                            ]
                        }
                    },
                    "required": [
                        "dropped_logs"
                    ],
                    "additionalProperties": false
                },
                {
                    "description": "Represents the number of logs that were dropped for a component by the archivist due to the\nlog buffer execeeding its maximum capacity before the current message.",
                    "type": "object",
                    "properties": {
                        "rolled_out_logs": {
                            "type": "object",
                            "properties": {
                                "count": {
                                    "type": "integer",
                                    "format": "uint64",
                                    "minimum": 0
                                }
                            },
                            "required": [
                                "count"
                            ]
                        }
                    },
                    "required": [
                        "rolled_out_logs"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "parse_record": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "parse_record"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "other": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    },
                    "required": [
                        "other"
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "integer": {
            "type": "integer",
            "format": "int64"
        },
        "Severity": {
            "description": "Severities a log message can have, often called the log's \"level\".",
            "oneOf": [
                {
                    "description": "Trace severity level",
                    "type": "string",
                    "const": "TRACE"
                },
                {
                    "description": "Debug severity level",
                    "type": "string",
                    "const": "DEBUG"
                },
                {
                    "description": "Info severity level",
                    "type": "string",
                    "const": "INFO"
                },
                {
                    "description": "Warn severity level",
                    "type": "string",
                    "const": "WARN"
                },
                {
                    "description": "Error severity level",
                    "type": "string",
                    "const": "ERROR"
                },
                {
                    "description": "Fatal severity level",
                    "type": "string",
                    "const": "FATAL"
                }
            ]
        },
        "DiagnosticsHierarchy": {
            "type": "object",
            "minProperties": 1,
            "patternProperties": {
                "^.*$": {
                    "description": "A property, which can be any standard object, or an array, or a histogram",
                    "anyOf": [
                        {
                            "type": "string"
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "number",
                                "format": "double"
                            }
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "integer",
                                "format": "int64"
                            }
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "integer",
                                "format": "uint64",
                                "minimum": 0
                            }
                        },
                        {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        },
                        {
                            "description": "A linear histogram property.",
                            "type": "object",
                            "properties": {
                                "size": {
                                    "description": "The number of buckets. If indexes is None this should equal counts.len().",
                                    "type": "integer",
                                    "format": "uint",
                                    "minimum": 0
                                },
                                "floor": {
                                    "description": "The floor of the lowest bucket (not counting the negative-infinity bucket).",
                                    "type": "integer",
                                    "format": "uint64",
                                    "minimum": 0
                                },
                                "step": {
                                    "description": "The increment for each bucket range.",
                                    "type": "integer",
                                    "format": "uint64",
                                    "minimum": 0
                                },
                                "counts": {
                                    "description": "The number of items in each bucket.",
                                    "type": "array",
                                    "items": {
                                        "type": "integer",
                                        "format": "uint64",
                                        "minimum": 0
                                    }
                                },
                                "indexes": {
                                    "description": "If Some<_>, the indexes of nonzero counts.",
                                    "type": [
                                        "array",
                                        "null"
                                    ],
                                    "items": {
                                        "type": "integer",
                                        "format": "uint",
                                        "minimum": 0
                                    }
                                }
                            },
                            "required": [
                                "size",
                                "floor",
                                "step",
                                "counts"
                            ]
                        },
                        {
                            "description": "A linear histogram property.",
                            "type": "object",
                            "properties": {
                                "size": {
                                    "description": "The number of buckets. If indexes is None this should equal counts.len().",
                                    "type": "integer",
                                    "format": "uint",
                                    "minimum": 0
                                },
                                "floor": {
                                    "description": "The floor of the lowest bucket (not counting the negative-infinity bucket).",
                                    "type": "integer",
                                    "format": "int64"
                                },
                                "step": {
                                    "description": "The increment for each bucket range.",
                                    "type": "integer",
                                    "format": "int64"
                                },
                                "counts": {
                                    "description": "The number of items in each bucket.",
                                    "type": "array",
                                    "items": {
                                        "type": "integer",
                                        "format": "int64"
                                    }
                                },
                                "indexes": {
                                    "description": "If Some<_>, the indexes of nonzero counts.",
                                    "type": [
                                        "array",
                                        "null"
                                    ],
                                    "items": {
                                        "type": "integer",
                                        "format": "uint",
                                        "minimum": 0
                                    }
                                }
                            },
                            "required": [
                                "size",
                                "floor",
                                "step",
                                "counts"
                            ]
                        },
                        {
                            "description": "A linear histogram property.",
                            "type": "object",
                            "properties": {
                                "size": {
                                    "description": "The number of buckets. If indexes is None this should equal counts.len().",
                                    "type": "integer",
                                    "format": "uint",
                                    "minimum": 0
                                },
                                "floor": {
                                    "description": "The floor of the lowest bucket (not counting the negative-infinity bucket).",
                                    "type": "number",
                                    "format": "double"
                                },
                                "step": {
                                    "description": "The increment for each bucket range.",
                                    "type": "number",
                                    "format": "double"
                                },
                                "counts": {
                                    "description": "The number of items in each bucket.",
                                    "type": "array",
                                    "items": {
                                        "type": "number",
                                        "format": "double"
                                    }
                                },
                                "indexes": {
                                    "description": "If Some<_>, the indexes of nonzero counts.",
                                    "type": [
                                        "array",
                                        "null"
                                    ],
                                    "items": {
                                        "type": "integer",
                                        "format": "uint",
                                        "minimum": 0
                                    }
                                }
                            },
                            "required": [
                                "size",
                                "floor",
                                "step",
                                "counts"
                            ]
                        },
                        {
                            "description": "An exponential histogram property.",
                            "type": "object",
                            "properties": {
                                "size": {
                                    "description": "The number of buckets. If indexes is None this should equal counts.len().",
                                    "type": "integer",
                                    "format": "uint",
                                    "minimum": 0
                                },
                                "floor": {
                                    "description": "The floor of the lowest bucket (not counting the negative-infinity bucket).",
                                    "type": "integer",
                                    "format": "uint64",
                                    "minimum": 0
                                },
                                "initial_step": {
                                    "description": "The increment for the second floor.",
                                    "type": "integer",
                                    "format": "uint64",
                                    "minimum": 0
                                },
                                "step_multiplier": {
                                    "description": "The multiplier for each successive floor.",
                                    "type": "integer",
                                    "format": "uint64",
                                    "minimum": 0
                                },
                                "counts": {
                                    "description": "The number of items in each bucket.",
                                    "type": "array",
                                    "items": {
                                        "type": "integer",
                                        "format": "uint64",
                                        "minimum": 0
                                    }
                                },
                                "indexes": {
                                    "description": "If Some<_>, the indexes of nonzero counts.",
                                    "type": [
                                        "array",
                                        "null"
                                    ],
                                    "items": {
                                        "type": "integer",
                                        "format": "uint",
                                        "minimum": 0
                                    }
                                }
                            },
                            "required": [
                                "size",
                                "floor",
                                "initial_step",
                                "step_multiplier",
                                "counts"
                            ]
                        },
                        {
                            "description": "An exponential histogram property.",
                            "type": "object",
                            "properties": {
                                "size": {
                                    "description": "The number of buckets. If indexes is None this should equal counts.len().",
                                    "type": "integer",
                                    "format": "uint",
                                    "minimum": 0
                                },
                                "floor": {
                                    "description": "The floor of the lowest bucket (not counting the negative-infinity bucket).",
                                    "type": "integer",
                                    "format": "int64"
                                },
                                "initial_step": {
                                    "description": "The increment for the second floor.",
                                    "type": "integer",
                                    "format": "int64"
                                },
                                "step_multiplier": {
                                    "description": "The multiplier for each successive floor.",
                                    "type": "integer",
                                    "format": "int64"
                                },
                                "counts": {
                                    "description": "The number of items in each bucket.",
                                    "type": "array",
                                    "items": {
                                        "type": "integer",
                                        "format": "int64"
                                    }
                                },
                                "indexes": {
                                    "description": "If Some<_>, the indexes of nonzero counts.",
                                    "type": [
                                        "array",
                                        "null"
                                    ],
                                    "items": {
                                        "type": "integer",
                                        "format": "uint",
                                        "minimum": 0
                                    }
                                }
                            },
                            "required": [
                                "size",
                                "floor",
                                "initial_step",
                                "step_multiplier",
                                "counts"
                            ]
                        },
                        {
                            "description": "An exponential histogram property.",
                            "type": "object",
                            "properties": {
                                "size": {
                                    "description": "The number of buckets. If indexes is None this should equal counts.len().",
                                    "type": "integer",
                                    "format": "uint",
                                    "minimum": 0
                                },
                                "floor": {
                                    "description": "The floor of the lowest bucket (not counting the negative-infinity bucket).",
                                    "type": "number",
                                    "format": "double"
                                },
                                "initial_step": {
                                    "description": "The increment for the second floor.",
                                    "type": "number",
                                    "format": "double"
                                },
                                "step_multiplier": {
                                    "description": "The multiplier for each successive floor.",
                                    "type": "number",
                                    "format": "double"
                                },
                                "counts": {
                                    "description": "The number of items in each bucket.",
                                    "type": "array",
                                    "items": {
                                        "type": "number",
                                        "format": "double"
                                    }
                                },
                                "indexes": {
                                    "description": "If Some<_>, the indexes of nonzero counts.",
                                    "type": [
                                        "array",
                                        "null"
                                    ],
                                    "items": {
                                        "type": "integer",
                                        "format": "uint",
                                        "minimum": 0
                                    }
                                }
                            },
                            "required": [
                                "size",
                                "floor",
                                "initial_step",
                                "step_multiplier",
                                "counts"
                            ]
                        },
                        {
                            "type": "integer",
                            "format": "int64"
                        },
                        {
                            "type": "integer",
                            "format": "uint64",
                            "minimum": 0
                        },
                        {
                            "type": "number",
                            "format": "double"
                        },
                        {
                            "type": "boolean"
                        },
                        {
                            "type": "object",
                            "allOf": [
                                {
                                    "$ref": "#/definitions/DiagnosticsHierarchy"
                                }
                            ]
                        }
                    ]
                }
            }
        }
    }
}
