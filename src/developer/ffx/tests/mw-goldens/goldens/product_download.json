{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "MachineOutput",
    "oneOf": [
        {
            "description": "CommandStatus is returned to indicate exit status of\na command. The Ok variant is optional, and is intended\nfor use with commands that return no other data so there\nis some indication of correct execution.",
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "command_status"
                }
            },
            "oneOf": [
                {
                    "description": "Successful execution with an optional informational string.",
                    "type": "object",
                    "properties": {
                        "ok": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                }
                            }
                        }
                    },
                    "required": [
                        "ok"
                    ]
                },
                {
                    "description": "Unexpected error with string.",
                    "type": "object",
                    "properties": {
                        "unexpected_error": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    },
                    "required": [
                        "unexpected_error"
                    ]
                },
                {
                    "description": "A known kind of error that can be reported usefully to the user",
                    "type": "object",
                    "properties": {
                        "user_error": {
                            "type": "object",
                            "properties": {
                                "message": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "message"
                            ]
                        }
                    },
                    "required": [
                        "user_error"
                    ]
                }
            ],
            "required": [
                "type"
            ]
        },
        {
            "type": "object",
            "properties": {
                "title": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "message": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "type": {
                    "type": "string",
                    "const": "notice"
                }
            },
            "required": [
                "type"
            ]
        },
        {
            "type": "object",
            "properties": {
                "type": {
                    "type": "string",
                    "const": "data"
                }
            },
            "required": [
                "type"
            ]
        }
    ]
}
