{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "CommandStatus",
    "oneOf": [
        {
            "description": "Successful execution with informational strings.",
            "type": "object",
            "properties": {
                "ok": {
                    "type": "object",
                    "properties": {
                        "messages": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "required": [
                        "messages"
                    ]
                }
            },
            "required": [
                "ok"
            ],
            "additionalProperties": false
        },
        {
            "description": "Unexpected error with string.",
            "type": "object",
            "properties": {
                "unexpected_error": {
                    "type": "object",
                    "properties": {
                        "message": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "message"
                    ]
                }
            },
            "required": [
                "unexpected_error"
            ],
            "additionalProperties": false
        },
        {
            "description": "A known kind of error that can be reported usefully to the user",
            "type": "object",
            "properties": {
                "user_error": {
                    "type": "object",
                    "properties": {
                        "message": {
                            "type": "string"
                        }
                    },
                    "required": [
                        "message"
                    ]
                }
            },
            "required": [
                "user_error"
            ],
            "additionalProperties": false
        }
    ]
}
