{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "CommandStatus",
    "anyOf": [
        {
            "description": "Successful execution with an optional informational string.",
            "type": "object",
            "properties": {
                "address": {
                    "type": "string"
                }
            },
            "required": [
                "address"
            ]
        },
        {
            "description": "Debug message",
            "type": "object",
            "properties": {
                "message": {
                    "type": "string"
                }
            },
            "required": [
                "message"
            ]
        },
        {
            "description": "Unexpected error with string.",
            "type": "object",
            "properties": {
                "error_message": {
                    "type": "string"
                }
            },
            "required": [
                "error_message"
            ]
        },
        {
            "description": "A known kind of error that can be reported usefully to the user",
            "type": "object",
            "properties": {
                "error_message": {
                    "type": "string"
                }
            },
            "required": [
                "error_message"
            ]
        }
    ]
}
