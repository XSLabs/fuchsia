{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Array_of_ShowDetail",
    "type": "array",
    "items": {
        "$ref": "#/definitions/ShowDetail"
    },
    "definitions": {
        "ShowDetail": {
            "description": "Indicates which details the \"show\" command should return.",
            "oneOf": [
                {
                    "type": "string",
                    "enum": [
                        "All"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "Cmd": {
                            "type": "object",
                            "properties": {
                                "program": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "args": {
                                    "type": [
                                        "array",
                                        "null"
                                    ],
                                    "items": {
                                        "type": "string"
                                    }
                                },
                                "env": {
                                    "type": [
                                        "object",
                                        "null"
                                    ],
                                    "additionalProperties": {
                                        "type": "string"
                                    }
                                }
                            }
                        }
                    },
                    "required": [
                        "Cmd"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "Config": {
                            "type": "object",
                            "properties": {
                                "flags": {
                                    "anyOf": [
                                        {
                                            "$ref": "#/definitions/FlagData"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "required": [
                        "Config"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "Device": {
                            "type": "object",
                            "properties": {
                                "device": {
                                    "anyOf": [
                                        {
                                            "$ref": "#/definitions/VirtualDeviceInfo"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ]
                                }
                            }
                        }
                    },
                    "required": [
                        "Device"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "Net": {
                            "type": "object",
                            "properties": {
                                "mode": {
                                    "anyOf": [
                                        {
                                            "$ref": "#/definitions/NetworkingMode"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ]
                                },
                                "mac_address": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "upscript": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "ports": {
                                    "type": [
                                        "object",
                                        "null"
                                    ],
                                    "additionalProperties": {
                                        "$ref": "#/definitions/PortMapping"
                                    }
                                }
                            }
                        }
                    },
                    "required": [
                        "Net"
                    ],
                    "additionalProperties": false
                },
                {
                    "type": "object",
                    "properties": {
                        "Instance": {
                            "type": "object",
                            "properties": {
                                "name": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "engine_type": {
                                    "anyOf": [
                                        {
                                            "$ref": "#/definitions/EngineType"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ]
                                },
                                "engine_state": {
                                    "anyOf": [
                                        {
                                            "$ref": "#/definitions/EngineState"
                                        },
                                        {
                                            "type": "null"
                                        }
                                    ]
                                },
                                "pid": {
                                    "type": [
                                        "integer",
                                        "null"
                                    ],
                                    "format": "uint32",
                                    "minimum": 0
                                },
                                "emulator_binary": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                },
                                "instance_directory": {
                                    "type": [
                                        "string",
                                        "null"
                                    ]
                                }
                            }
                        }
                    },
                    "required": [
                        "Instance"
                    ],
                    "additionalProperties": false
                }
            ]
        },
        "FlagData": {
            "type": "object",
            "properties": {
                "args": {
                    "description": "Arguments. The set of flags which follow the \"-fuchsia\" option. These are not processed by\nFemu, but are passed through to Qemu.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "envs": {
                    "description": "Environment Variables. These are not passed on the command line, but are set in the\nprocess's environment before execution.",
                    "type": "object",
                    "additionalProperties": {
                        "type": "string"
                    }
                },
                "features": {
                    "description": "Features. A Femu-only field. Features are the first set of command line flags passed to the\nFemu binary. These are single words, capitalized, comma-separated, and immediately follow\nthe flag \"-feature\".",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "kernel_args": {
                    "description": "Kernel Arguments. The last part of the command line. A set of text values that are passed\nthrough the emulator executable directly to the guest system's kernel.",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "options": {
                    "description": "Options. A Femu-only field. Options come immediately after features. Options may be boolean\nflags (e.g. -no-hidpi-scaling) or have associated values (e.g. -window-size 1280x800).",
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            },
            "required": [
                "args",
                "envs",
                "features",
                "kernel_args",
                "options"
            ]
        },
        "VirtualDeviceInfo": {
            "type": "object",
            "properties": {
                "name": {
                    "description": "A unique name identifying the virtual device specification.",
                    "type": "string"
                },
                "description": {
                    "description": "An optional human readable description.",
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "cpu": {
                    "description": "Details of the Central Processing Unit (CPU).",
                    "type": "string"
                },
                "cpu_count": {
                    "description": "Count of Central Processing Units present.",
                    "type": "integer",
                    "format": "uint",
                    "minimum": 0
                },
                "audio": {
                    "description": "Details about any audio devices included in the virtual device.",
                    "type": "string"
                },
                "storage_bytes": {
                    "description": "The size of the disk image for the virtual device, equivalent to virtual\nstorage capacity.",
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                },
                "pointing_device": {
                    "description": "Details about any input devices, such as a mouse or touchscreen.",
                    "type": "string"
                },
                "memory_bytes": {
                    "description": "Amount of memory in the virtual device.",
                    "type": "integer",
                    "format": "uint64",
                    "minimum": 0
                },
                "ports": {
                    "description": "A map of names to port numbers. These are the ports that need to be\navailable to the virtual device, though a given use case may not require\nall of them. When emulating with user-mode networking, these must be\nmapped to host-side ports to allow communication into the emulator from\nexternal tools (such as ssh and mDNS). When emulating with Tun/Tap mode\nnetworking port mapping is superfluous, so we expect this field to be\nignored.",
                    "type": [
                        "object",
                        "null"
                    ],
                    "additionalProperties": {
                        "type": "integer",
                        "format": "uint16",
                        "minimum": 0,
                        "maximum": 65535
                    }
                },
                "window_height": {
                    "description": "The height of the virtual device's screen, measured in pixels.",
                    "type": "integer",
                    "format": "uint",
                    "minimum": 0
                },
                "window_width": {
                    "description": "The width of the virtual device's screen, measured in pixels.",
                    "type": "integer",
                    "format": "uint",
                    "minimum": 0
                },
                "cid": {
                    "description": "The context identifier for the virtual machine.",
                    "type": "integer",
                    "format": "uint32",
                    "minimum": 0
                }
            },
            "required": [
                "name",
                "cpu",
                "cpu_count",
                "audio",
                "storage_bytes",
                "pointing_device",
                "memory_bytes",
                "window_height",
                "window_width",
                "cid"
            ]
        },
        "NetworkingMode": {
            "description": "Selector for the mode of networking to enable between the guest and host systems.",
            "oneOf": [
                {
                    "description": "Allow the system to determine the best available networking option. Typically\nthis means \"Tap\", falling back to \"User\" if Tap is unavailable.",
                    "type": "string",
                    "const": "auto"
                },
                {
                    "description": "Networking will be set up in bridged mode, using an interface such as tun/tap.",
                    "type": "string",
                    "const": "tap"
                },
                {
                    "description": "Networking will be over explicitly mapped ports, using an interface such as SLiRP.",
                    "type": "string",
                    "const": "user"
                },
                {
                    "description": "Guest networking will be disabled.",
                    "type": "string",
                    "const": "none"
                }
            ]
        },
        "PortMapping": {
            "description": "Holds a single mapping from a host port to the guest.",
            "type": "object",
            "properties": {
                "guest": {
                    "type": "integer",
                    "format": "uint16",
                    "minimum": 0,
                    "maximum": 65535
                },
                "host": {
                    "type": [
                        "integer",
                        "null"
                    ],
                    "format": "uint16",
                    "minimum": 0,
                    "maximum": 65535
                }
            },
            "required": [
                "guest"
            ]
        },
        "EngineType": {
            "oneOf": [
                {
                    "description": "Fuchsia Emulator based on AEMU. Supports graphics.",
                    "type": "string",
                    "const": "femu"
                },
                {
                    "description": "Qemu emulator.",
                    "type": "string",
                    "const": "qemu"
                },
                {
                    "description": "Crosvm emulator.",
                    "type": "string",
                    "const": "crosvm"
                }
            ]
        },
        "EngineState": {
            "description": "The emulator engine follows a strict state transition graph, as outlined below.\n\n              ---------------------------------------\n              |             |                       v\nNew ---> Configured ---> Staged <---> Running ---> end\n |            |             |            |          ^\n ----------------> Error <----------------          |\n                     |                              |\n                     -------------------------------|",
            "oneOf": [
                {
                    "description": "The New state is the initial state of the engine. This is the state assigned to the\nemulator when the data structure is first initialized. It indicates nothing has\noccurred yet.",
                    "type": "string",
                    "const": "new"
                },
                {
                    "description": "When an emulator is in the Configured state, it indicates that the input has been processed\nand the EmulationConfiguration populated with the values provided by the user. The emulator\ninstance directory has been created, but only the engine state and configuration are there.\nWhen the --dry-run flag is included, this is where the `start` subcommand terminates. There\nare no commands to trigger state transitions for an engine that has landed in the\nConfigured state, but the configuration can be observed, saved, or modified for use on\nfuture instances with `ffx emu show --config` or similar subcommands.",
                    "type": "string",
                    "const": "configured"
                },
                {
                    "description": "When an emulator is in the Staged state, it indicates that configuration step was\nsuccessful and that the files needed to run the emulator have been copied into the instance\ndirectory, and any required modifications to those files have been performed. An emulator\ncan also reach Staged without copying runtime files to the instance directory if the user\nprovides a custom configuration with the --config flag; any files specified in such a\nconfiguration are unverified, unmodified, and executed from the location provided rather\nthan staged.\n\nWhen the --stage flag is included, this is where the `start` subcommand terminates. This is\nalso the state of an emulator that was running but has been stopped by some means, such as\n`ffx emu stop --persist`, or `power off` in the serial console. A Staged instance can be\n(re)started with `ffx emu start --reuse`.",
                    "type": "string",
                    "const": "staged"
                },
                {
                    "description": "When an emulator is in the Running state, it indicates that there is a process on the host\nexecuting the Fuchsia system according to the engine's configuration. There are no\nguarantees about the guest regarding accessibility or progress on any internal boot\nprocesses.",
                    "type": "string",
                    "const": "running"
                },
                {
                    "description": "An emulator in the Error state has no guarantees about the internal state. This state may\nbe entered from any other state for any reason. An emulator in the Error state is no longer\nviable for execution or any other forward progress; it exists for retrospective analysis\nand debugging purposes only. All artifacts that were generated in previous states are\nretained in the instance directory for this purpose.",
                    "type": "string",
                    "const": "error"
                }
            ]
        }
    }
}
