{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Array_of_JsonTarget",
    "type": "array",
    "items": {
        "$ref": "#/definitions/JsonTarget"
    },
    "definitions": {
        "JsonTarget": {
            "type": "object",
            "properties": {
                "nodename": {
                    "type": "string"
                },
                "rcs_state": {
                    "type": "string"
                },
                "serial": {
                    "type": "string"
                },
                "target_type": {
                    "type": "string"
                },
                "target_state": {
                    "type": "string"
                },
                "addresses": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/JsonTargetAddress"
                    }
                },
                "is_default": {
                    "type": "boolean"
                },
                "is_manual": {
                    "type": "boolean"
                }
            },
            "required": [
                "nodename",
                "rcs_state",
                "serial",
                "target_type",
                "target_state",
                "addresses",
                "is_default",
                "is_manual"
            ]
        },
        "JsonTargetAddress": {
            "oneOf": [
                {
                    "type": "object",
                    "properties": {
                        "ip": {
                            "type": "string"
                        },
                        "ssh_port": {
                            "type": "integer",
                            "format": "uint16",
                            "minimum": 0,
                            "maximum": 65535
                        },
                        "type": {
                            "type": "string",
                            "const": "Ip"
                        }
                    },
                    "required": [
                        "type",
                        "ip",
                        "ssh_port"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "cid": {
                            "type": "integer",
                            "format": "uint32",
                            "minimum": 0
                        },
                        "type": {
                            "type": "string",
                            "const": "VSock"
                        }
                    },
                    "required": [
                        "type",
                        "cid"
                    ]
                },
                {
                    "type": "object",
                    "properties": {
                        "cid": {
                            "type": "integer",
                            "format": "uint32",
                            "minimum": 0
                        },
                        "type": {
                            "type": "string",
                            "const": "Usb"
                        }
                    },
                    "required": [
                        "type",
                        "cid"
                    ]
                }
            ]
        }
    }
}
