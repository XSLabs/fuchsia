import("//build/rust/rustc_library.gni")

assert(is_host, "ffx_config is for use with the host toolchain only")

rustc_library("lib") {
  name = "ffx_core"
  version = "0.1.0"
  edition = "2024"

  deps = [ "macro:lib" ]

  sources = [ "src/lib.rs" ]
}

group("tests") {
  testonly = true
  deps = [ "macro:tests" ]
}
