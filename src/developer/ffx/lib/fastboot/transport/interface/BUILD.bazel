load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "lib",
    srcs = [
        "src/lib.rs",
        "src/tcp.rs",
        "src/udp.rs",
    ],
    crate_name = "ffx_fastboot_transport_interface",
    edition = "2024",
    target_compatible_with = HOST_CONSTRAINTS,
    test_deps = [
        "//src/lib/fuchsia",
        "//third_party/rust_crates/vendor:anyhow",
        "//third_party/rust_crates/vendor:pretty_assertions",
    ],
    version = "0.1.0",
    visibility = [
        "//src/developer/ffx/lib/fastboot:__pkg__",
        "//src/developer/ffx/lib/fastboot/connection_factory:__pkg__",
        "//src/developer/ffx/lib/fastboot/transport/factory:__pkg__",
        "//src/developer/ffx/lib/manual_targets:__pkg__",
        "//src/developer/ffx/plugins/target/fastboot:__pkg__",
        "//visibility:private",
    ],
    with_host_unit_tests = True,
    deps = [
        "//src/developer/ffx/lib/netext:lib",
        "//src/developer/ffx/lib/timeout:lib",
        "//third_party/rust_crates/vendor:byteorder",
        "//third_party/rust_crates/vendor:futures",
        "//third_party/rust_crates/vendor:log",
        "//third_party/rust_crates/vendor:socket2",
        "//third_party/rust_crates/vendor:thiserror",
        "//third_party/rust_crates/vendor:tokio",
        "//third_party/rust_crates/vendor:zerocopy",
    ],
)
