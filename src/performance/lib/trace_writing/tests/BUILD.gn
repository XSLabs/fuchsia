import("//build/python/python_host_test.gni")

assert(is_host)

python_host_test("fxt_test") {
  main_source = "fxt_test.py"
  libraries = [
    "//src/performance/lib/trace_writing",
    "//src/performance/lib/trace_processing",
  ]
}

python_host_test("json2fxt_test") {
  main_source = "json2fxt_test.py"
  sources = [ "../scripts/json2fxt.py" ]
  libraries = [ "//src/performance/lib/trace_writing" ]
  deps =
      [ "//src/performance/lib/trace_processing/tests:trace_metrics_test_data" ]
}

group("tests") {
  testonly = true
  public_deps = [
    ":fxt_test",
    ":json2fxt_test",
  ]
}
