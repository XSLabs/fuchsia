import("//build/components.gni")
import("//build/rust/rustc_binary.gni")

rustc_binary("bin") {
  name = "zxsh"
  edition = "2024"
  with_unit_tests = true
  sources = [
    "src/args.rs",
    "src/builtins/essential.rs",
    "src/builtins/mod.rs",
    "src/collections.rs",
    "src/errors.rs",
    "src/eval/arithmetic.rs",
    "src/eval/control_flow.rs",
    "src/eval/execution_context.rs",
    "src/eval/expand.rs",
    "src/eval/format.rs",
    "src/eval/glob.rs",
    "src/eval/mod.rs",
    "src/eval/redirect.rs",
    "src/eval/signals.rs",
    "src/eval/simple.rs",
    "src/eval/spawn.rs",
    "src/eval/state.rs",
    "src/fd.rs",
    "src/main.rs",
    "src/parser/ast.rs",
    "src/parser/error.rs",
    "src/parser/mod.rs",
    "src/parser/parser.rs",
    "src/parser/token.rs",
    "src/parser/tokenizer.rs",
    "src/process.rs",
    "src/relative.rs",
    "src/repl/completion.rs",
    "src/repl/linenoise.rs",
    "src/repl/mod.rs",
    "src/runner.rs",
    "src/serialization.rs",
    "src/sort.rs",
    "src/string.rs",
    "src/subshell.rs",
    "src/tests/args.rs",
    "src/tests/arithmetic.rs",
    "src/tests/ast.rs",
    "src/tests/builtins.rs",
    "src/tests/collections.rs",
    "src/tests/control_flow.rs",
    "src/tests/errors.rs",
    "src/tests/expand.rs",
    "src/tests/format.rs",
    "src/tests/glob.rs",
    "src/tests/mod.rs",
    "src/tests/parser.rs",
    "src/tests/process.rs",
    "src/tests/redirect.rs",
    "src/tests/serialization.rs",
    "src/tests/signals.rs",
    "src/tests/simple.rs",
    "src/tests/sort.rs",
    "src/tests/spawn.rs",
    "src/tests/state.rs",
    "src/tests/string.rs",
    "src/tests/tokenizer.rs",
    "src/tty.rs",
  ]
  deps = [
    "//sdk/fidl/fuchsia.hardware.pty:fuchsia.hardware.pty_rust",
    "//sdk/rust/zx",
    "//src/lib/fdio/rust:fdio",
    "//src/lib/fuchsia-runtime",
    "//src/lib/fuchsia-sync",
    "//third_party/rust_crates:bitflags",
    "//third_party/rust_crates:bstr",
    "//third_party/rust_crates:libc",
    "//third_party/rust_crates:zerocopy",
    "//zircon/third_party/ulib/linenoise",
  ]
}

fuchsia_package("zxsh") {
  deps = [ ":bin" ]
}

fuchsia_unittest_package("zxsh_tests") {
  manifest = "meta/zxsh_tests.cml"
  deps = [
    ":bin",
    ":bin_test",
    "//zircon/third_party/uapp/dash",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":zxsh_tests" ]
}
