{
    actions: [
        {
            type: "expect_pass",
            matchers: [
                "*",
            ],
        },
        {
            type: "expect_pass_with_err_logs",
            matchers: [
                "dhcp_server_persistence_mode_persistent",
                "dhcp_server_persistence_mode_ephemeral",
            ],
        },
    ],
}
