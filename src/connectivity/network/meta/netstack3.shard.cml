{
    children: [
        {
            name: "netstack",
            url: "fuchsia-pkg://fuchsia.com/netstack3#meta/netstack3.cm",
            on_terminate: "reboot",
        },
    ],
    expose: [
        // TODO(https://fxbug.dev/324494668): remove this when Netstack2 is gone.
        {
            directory: "diagnostics",
            from: "void",
            as: "netstack-diagnostics",
            availability: "optional",
        },
    ],
}
