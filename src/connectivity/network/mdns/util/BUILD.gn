import("//build/components.gni")
import("//build/test.gni")

group("util") {
  testonly = true
  deps = [ ":mdns-util" ]
}

fuchsia_package("mdns-util") {
  deps = [ ":bin" ]
}

executable("bin") {
  output_name = "mdns-util"

  sources = [ "main.cc" ]

  deps = [
    ":source_set",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
  ]
}

source_set("source_set") {
  sources = [
    "commands.cc",
    "commands.h",
    "formatting.cc",
    "formatting.h",
    "mdns_impl.cc",
    "mdns_impl.h",
  ]

  public_deps = [
    "//sdk/fidl/fuchsia.net.mdns:fuchsia.net.mdns_hlcpp",
    "//sdk/lib/async-loop:async-loop-cpp",
    "//sdk/lib/async-loop:async-loop-default",
    "//sdk/lib/sys/cpp",
    "//sdk/lib/syslog/cpp",
    "//src/lib/fostr",
    "//src/lib/fsl",
    "//src/lib/fxl:fxl_cli",
    "//src/lib/inet",
    "//src/lib/line_input",
  ]
}

test("mdns_util_test") {
  sources = [ "test/mdns_impl_test.cc" ]

  deps = [
    ":source_set",
    "//sdk/lib/sys/cpp/testing:cpp",
    "//src/lib/fxl/test:gtest_main",
    "//src/lib/testing/loop_fixture",
  ]
}

fuchsia_unittest_package("mdns-util-tests") {
  deps = [ ":mdns_util_test" ]
}

group("tests") {
  testonly = true
  deps = [ ":mdns-util-tests" ]
}
