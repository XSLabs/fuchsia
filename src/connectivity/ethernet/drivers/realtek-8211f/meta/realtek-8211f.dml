{
    name: "rtl8211f_bind",
    include: [ "//sdk/lib/driver/compat/compat.shard.cml" ],
    program: {
        colocate: "true",
        compat: "driver/realtek-8211f.so",
        default_dispatcher_opts: [ "allow_sync_calls" ],
        bind: { protocol: "fuchsia.ethernet.BIND_PROTOCOL.MAC" },
    },
}
