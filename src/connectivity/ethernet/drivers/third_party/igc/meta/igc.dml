{
    name: "igc_bind",
    composite_name: "igc",
    include: [ "driver_component/driver.shard.cml" ],
    program: {
        binary: "driver/igc.so",
    },
    capabilities: [
        { service: "fuchsia.hardware.network.driver.Service" },
    ],
    use: [
        {
            name: "pci",
            service: "fuchsia.hardware.pci.Service",
            primary: true,
            bind: {
                service: "fuchsia.hardware.pci.Service",
                rules: {
                    "fuchsia.BIND_PCI_VID": "fuchsia.pci.BIND_PCI_VID.INTEL",
                    "fuchsia.BIND_PCI_DID": "0x15F2",
                },
            },
        },
        {
            name: "acpi",
            availability: "optional",
            bind: { protocol: "fuchsia.acpi.BIND_PROTOCOL.DEVICE" },
        },
    ],
    expose: [
        {
            service: "fuchsia.hardware.network.driver.Service",
            from: "self",
        },
    ],
}
