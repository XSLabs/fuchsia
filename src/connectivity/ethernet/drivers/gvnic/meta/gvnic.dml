{
  name: "gvnic",
  include: [
    "//sdk/lib/driver/compat/compat.shard.cml"
  ],
  program: {
    compat: "driver/gvnic.so"
  },
  capabilities: [
    {
      service: "fuchsia.hardware.network.driver.Service"
    }
  ],
  use: [
    {
      service: "fuchsia.hardware.pci.Service",
      name: "pci",
      primary: true,
      bind: {
        service: "fuchsia.hardware.pci.Service",
        pci: {
          vid: "fuchsia.pci.BIND_PCI_VID.GOOGLE",
          did: "0x0042",
        },
      }
    },
    {
      availability: "optional",
      name: "acpi",
      bind: {
        banjo: "fuchsia.acpi.BIND_PROTOCOL.DEVICE"
      }
    }
  ],
  expose: [
    {
      service: "fuchsia.hardware.network.driver.Service",
      from: "self"
    }
  ]
}
