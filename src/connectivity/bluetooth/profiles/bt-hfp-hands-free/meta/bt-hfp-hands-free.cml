{
    include: [
        "inspect/client.shard.cml",
        "syslog/client.shard.cml",
    ],
    program: {
        runner: "elf",
        binary: "bin/bt_hfp_hands_free",
    },
    capabilities: [
        {
            protocol: [ "fuchsia.bluetooth.hfp.HandsFree" ],
        },
    ],
    use: [
        { service: "fuchsia.hardware.audio.DaiConnectorService" },
        {
            protocol: [
                "fuchsia.bluetooth.bredr.Profile",
                "fuchsia.media.AudioDeviceEnumerator",
                "fuchsia.mediacodec.CodecFactory",
                "fuchsia.sysmem.Allocator",
                "fuchsia.sysmem2.Allocator",
            ],
            from: "parent",
        },
        {
            protocol: [ "fuchsia.bluetooth.internal.a2dp.Controller" ],
        },
        {
            config: "fuchsia.bluetooth.EchoCancelingAndNoiseReduction",
            key: "ec_or_nr",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.bluetooth.CallWaitingOrThreeWayCalling",
            key: "call_waiting_or_three_way_calling",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.bluetooth.CliPresentationCapability",
            key: "cli_presentation_capability",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.bluetooth.VoiceRecognitionActivation",
            key: "voice_recognition_activation",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.bluetooth.RemoteVolumeControl",
            key: "remote_volume_control",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.bluetooth.WideBandSpeech",
            key: "wide_band_speech",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.bluetooth.EnhancedVoiceRecognition",
            key: "enhanced_voice_recognition",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.bluetooth.EnhancedVoiceRecognitionWithText",
            key: "enhanced_voice_recognition_with_text",
            type: "bool",
            availability: "optional",
            default: false,
        },
        {
            config: "fuchsia.bluetooth.ControllerEncodingCvsd",
            key: "controller_encoding_cvsd",
            type: "bool",
            availability: "optional",
            default: true,
        },
        {
            config: "fuchsia.bluetooth.ControllerEncodingMsbc",
            key: "controller_encoding_msbc",
            type: "bool",
            availability: "optional",
            default: true,
        },
        {
            config: "fuchsia.bluetooth.OffloadType",
            key: "offload_type",
            type: "string",
            max_size: 8,
            availability: "optional",
            default: "codec",
        },
    ],
    expose: [
        {
            protocol: [ "fuchsia.bluetooth.hfp.HandsFree" ],
            from: "self",
        },
    ],
}
