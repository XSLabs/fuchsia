import("//build/rust/rustc_library.gni")
import("//build/rust/rustc_test.gni")
import(
    "//third_party/github.com/google/experimental-emboss-rust/build_defs.gni")

emboss_rust_library("example_emb") {
  source = "emboss/example.emb"
}

emboss_rust_library("example2_emb") {
  source = "emboss/example2.emb"
  deps = [ ":example_emb" ]
  imports = [ "emboss/example.emb" ]
}

rustc_library("sapphire-emboss") {
  edition = "2024"
  with_unit_tests = true
  sources = [ "src/lib.rs" ]
  deps = [
    ":example2_emb",
    ":example_emb",
  ]
}

group("tests") {
  testonly = true
  deps = [ ":sapphire-emboss_test($host_toolchain)" ]
}
