import("//build/bazel/bazel_test_suite.gni")

group("connectivity") {
  testonly = true
  deps = [ ":connectivity_no_e2e" ]
}

group("connectivity_no_e2e") {
  testonly = true
  assert_no_deps = e2e_test_libs

  deps = [
    ":tests_no_e2e",
    "bluetooth",
    "location",
    "lowpan",
    "overnet",
    "weave",
    "wlan",
  ]
}

group("tests_no_e2e") {
  testonly = true
  assert_no_deps = e2e_test_libs

  deps = [
    ":bazel_tests",
    "bluetooth:tests",
    "ethernet:tests",
    "lib:tests",
    "location:tests",
    "lowpan:tests",
    "network:tests",
    "nfc:tests",
    "openthread:tests",
    "overnet:tests_no_e2e",
    "policy:tests",
    "telephony:tests",
    "weave:tests",
    "wlan:tests",
  ]
}

bazel_test_suite("bazel_tests") {
  host_tests = [ "//src/connectivity:host_tests" ]
  target_tests = [ "//src/connectivity:target_tests" ]
}

group("tests") {
  testonly = true
  deps = [ ":tests_no_e2e" ]
}

group("benchmarks") {
  testonly = true
  deps = [
    "lib:benchmarks",
    "network:benchmarks",
  ]
}
