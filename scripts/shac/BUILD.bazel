# host_shac_test() runs `shac test` in a minimal checkout containing only the
# test's declared data, so tests depend on this to be able to load the check
# implementations they test.
filegroup(
    name = "starlark_files",
    testonly = True,
    srcs = glob(["*.star"]),
    visibility = ["//scripts/shac/tests:__subpackages__"],
)
