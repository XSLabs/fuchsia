import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("seriallistener") {
    bazel_target = ":seriallistener"
    bazel_output_path =
        "{{BAZEL_TARGET_OUT_DIR}}/seriallistener_/seriallistener"
  }
} else {
  group("seriallistener") {
    public_deps = [ ":seriallistener($host_toolchain)" ]
  }
}
