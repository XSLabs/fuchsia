import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("test_filterer") {
    bazel_target = ":test_filterer"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/test_filterer_/test_filterer"
  }
} else {
  group("test_filterer") {
    public_deps = [ ":test_filterer($host_toolchain)" ]
  }
}
