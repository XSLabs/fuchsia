import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("resultdb") {
    bazel_target = ":resultdb"
    bazel_output_path = "{{BAZEL_TARGET_OUT_DIR}}/resultdb_/resultdb"
  }
} else {
  group("resultdb") {
    public_deps = [ ":resultdb($host_toolchain)" ]
  }
}
