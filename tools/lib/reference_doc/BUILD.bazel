load("//build/bazel/rules/rust:defs.bzl", "rustc_library")

package(default_applicable_licenses = ["//:license"])

rustc_library(
    name = "reference_doc",
    srcs = ["src/lib.rs"],
    edition = "2024",
    proc_macro_deps = [
        "//tools/lib/reference_doc/macro",
    ],
    visibility = [
        "//tools/cmc:__pkg__",
        "//tools/lib/cml:__pkg__",
        "//tools/lib/reference_doc/macro/derive-reference-doc-tests:__pkg__",
    ],
    with_host_unit_tests = True,
)
