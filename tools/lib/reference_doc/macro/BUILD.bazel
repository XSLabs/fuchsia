load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/rules/rust:defs.bzl", "rustc_proc_macro")

package(default_applicable_licenses = ["//:license"])

rustc_proc_macro(
    name = "macro",
    srcs = [
        "src/derive_reference_doc.rs",
        "src/lib.rs",
    ],
    crate_name = "reference_doc_macro",
    edition = "2024",
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//tools/lib/reference_doc:__pkg__"],
    deps = [
        "//third_party/rust_crates/vendor:darling",
        "//third_party/rust_crates/vendor:proc-macro2",
        "//third_party/rust_crates/vendor:quote",
        "//third_party/rust_crates/vendor:syn",
    ],
)
