import("//build/go/go_test.gni")

assert(is_host, "GIDL only runs on host")

go_test("gidl_mixer_tests") {
  embed = [ ":mixer" ]
  sources = [ "mixer_test.go" ]
  args = [
    "--test_data_dir",
    rebase_path("$root_out_dir/test_data/gidl", root_build_dir),
  ]
  non_go_deps = [ "testdata:json_ir" ]
}

