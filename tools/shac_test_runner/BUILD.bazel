load("@io_bazel_rules_go//go:def.bzl", "go_library")
load("@platforms//host:constraints.bzl", "HOST_CONSTRAINTS")
load("//build/bazel/rules/host:defs.bzl", "go_binary_host_tool")
load("//build/bazel/rules/host_tests:host_go_test.bzl", "host_go_test")

package(default_applicable_licenses = ["//:license"])

go_library(
    name = "main",
    srcs = [
        "main.go",
        "parse.go",
    ],
    importpath = "go.fuchsia.dev/fuchsia/tools/shac_test_runner",
    target_compatible_with = HOST_CONSTRAINTS,
    deps = [
        "//tools/lib/jsonutil",
        "//tools/testing/runtests",
        "//tools/testing/testrunner:constants",
    ],
)

# Used as the entry point of every host_shac_test() target.
go_binary_host_tool(
    name = "shac_test_runner",
    embed = [":main"],
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//build/bazel/rules/host_tests:__pkg__"],
)

host_go_test(
    name = "shac_test_runner_tests",
    srcs = [
        "main_test.go",
        "parse_test.go",
    ],
    embed = [":main"],
    target_compatible_with = HOST_CONSTRAINTS,
    visibility = ["//tools:__pkg__"],
    deps = [
        "//third_party/golibs:github.com/google/go-cmp/cmp",
        "//tools/testing/runtests",
    ],
)
