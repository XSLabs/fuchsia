import("//build/bazel/bazel_host_tool.gni")

if (is_host) {
  bazel_host_tool("mobly_test_parser") {
    bazel_target = ":mobly_test_parser"
    bazel_output_path =
        "{{BAZEL_TARGET_OUT_DIR}}/mobly_test_parser_/mobly_test_parser"
  }
} else {
  group("mobly_test_parser") {
    public_deps = [ ":mobly_test_parser($host_toolchain)" ]
  }
}
