library fuchsia.diagnostics;

@available(added=HEAD)
type PowerEvent = flexible enum {
    /// Boost started
    BOOST_START = 1;
    /// Boost ended
    BOOST_END = 2;
};

@available(added=HEAD)
type SystemActivityEvent = flexible union {
    1: power_event PowerEvent;
};

@discoverable(server="platform")
@available(added=HEAD)
open protocol SystemActivityMonitor {
    /// Blocks until a system activity event (e.g. CPU boost starting or ending)
    /// occurs, returning the event.
    flexible GetNextEvent() -> (struct {
        event SystemActivityEvent;
    });
};
