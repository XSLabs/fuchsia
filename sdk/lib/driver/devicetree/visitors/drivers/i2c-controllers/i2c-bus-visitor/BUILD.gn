fuchsia_unittest_package("i2c-bus-visitor-test") {
  component_name = "i2c-bus-visitor-test"
  deps = [
    ":i2c-bus-visitor-test-bin",
    ":i2c-channels-dtb-file",
    ":i2c-channels-duplicate-names-dtb-file",
    ":i2c-channels-duplicate-phandles-dtb-file",
    ":i2c-channels-grandchild-dtb-file",
    ":i2c-channels-multi-address-dtb-file",
    ":i2c-channels-multiple-referrers-dtb-file",
    ":i2c-channels-names-mismatch-dtb-file",
    ":i2c-channels-no-names-dtb-file",
    ":i2c-channels-not-i2c-child-dtb-file",
    ":i2c-channels-own-name-collision-dtb-file",
    ":i2c-channels-referenced-compatible-dtb-file",
    ":i2c-channels-self-reference-dtb-file",
    ":i2c-channels-shared-address-dtb-file",
    ":i2c-dtb-file",
  ]

  # The error-case tests log errors.
  test_specs = {
    log_settings = {
      max_severity = "ERROR"
    }
  }
}
