  sources = [ "test/dts/i2c-channels-shared-address.dts.S" ]

  # -Wno-unique_unit_address is needed because the test DTS
  # (i2c-channels-shared-address.dts.S) intentionally defines duplicate unit
  # addresses (child@c and child-dup@c) to test the rejection of references to
  # a shared address.
  dtcflags = [ "-Wno-unique_unit_address" ]
}

